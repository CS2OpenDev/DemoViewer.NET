<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>DemoViewer.NET.UiCapture</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Headless Skia render capture (mirrors the App.Tests package set, minus the test runner).
             HeadlessUnitTestSession lives in Avalonia.Headless core, so this needs no test framework. -->
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Headless"/>
        <PackageReference Include="Avalonia.Skia"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The real app, so its styles / DarkPalette tokens / DataTemplates load into every capture. -->
        <ProjectReference Include="..\DemoViewer.NET\DemoViewer.NET.csproj"/>
        <!-- The Strat Book variants render the extension's views. -->
        <ProjectReference Include="..\..\Extensions\StratBook\DemoViewer.NET.Extensions.StratBook\DemoViewer.NET.Extensions.StratBook.csproj"/>
        <ProjectReference Include="..\..\Extensions\RuleCanvas\DemoViewer.NET.Extensions.RuleCanvas\DemoViewer.NET.Extensions.RuleCanvas.csproj"/>
        <!-- The out-of-tree stand-in, rendered from its own namespace with the host's look. -->
        <ProjectReference Include="..\..\Testing\ThirdPartyFake\ThirdPartyFake.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="DemoViewer.NET.Extensions.Sdk"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The shipped rules, next to the binary as the Desktop head packages them. RuleSetLocator
             resolves them there, and without them a whole-shell capture evaluates nothing: no stats,
             no highlights, and an "Analysis failed" banner. -->
        <Content Include="..\..\..\rules\**"
                 LinkBase="rules"
                 CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
