<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DemoViewer.NET.ViewModels.Settings"
             xmlns:views="using:DemoViewer.NET.Views.Settings"
             x:Class="DemoViewer.NET.Views.Settings.ThemeEditorView"
             x:DataType="vm:ThemeEditorViewModel"
             Background="{DynamicResource ShellBg}">

    <UserControl.Styles>
        <Style Selector="Border.token-row">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.token-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource FrameRowHoverBg}" />
        </Style>
        <Style Selector="Border.token-row.missing">
            <Setter Property="Background" Value="{DynamicResource DeltaRowBg}" />
        </Style>
        <Style Selector="Border.token-row.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInteractive}" />
            <Setter Property="Background" Value="{DynamicResource FrameRowSelectedBg}" />
        </Style>
        <Style Selector="Button.theme-item">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.theme-item.selected">
            <Setter Property="Background" Value="{DynamicResource FrameRowSelectedBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInteractive}" />
        </Style>
        <Style Selector="TextBox.hex-bad">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentError}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="*,Auto">
            <Grid ColumnDefinitions="220,*,400">

                <!-- ── Theme list ─────────────────────────────────────────────── -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="sectionHeader">
                            <TextBlock Classes="sectionLabel" Text="THEMES" />
                        </Border>
                        <StackPanel DockPanel.Dock="Bottom" Margin="10" Spacing="4"
                                    IsVisible="{Binding HasLoadProblems}">
                            <TextBlock Text="Couldn't load" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentCaution}" />
                            <ItemsControl ItemsSource="{Binding LoadProblems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextDim}" Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Themes}" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThemeEditorListItem">
                                        <Button Classes="theme-item" Classes.selected="{Binding IsSelected}"
                                                Margin="0,1"
                                                Command="{Binding $parent[UserControl].((vm:ThemeEditorViewModel)DataContext).OpenCommand, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                                                            VerticalAlignment="Center">
                                                    <Border Classes="badge" Padding="5,1"
                                                            IsVisible="{Binding IsBuiltIn}">
                                                        <TextBlock Text="Built-in" FontSize="10"
                                                                   Foreground="{DynamicResource TextMid}" />
                                                    </Border>
                                                    <Border Classes="badge" Padding="5,1"
                                                            IsVisible="{Binding HasMissing}">
                                                        <TextBlock Text="{Binding MissingText}" FontSize="10"
                                                                   Foreground="{DynamicResource AccentCaution}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="6" Height="6"
                                                             Fill="{DynamicResource AccentInteractive}"
                                                             VerticalAlignment="Center"
                                                             IsVisible="{Binding IsActive}"
                                                             ToolTip.Tip="Your current theme" />
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{DynamicResource TextBright}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ── Tokens ─────────────────────────────────────────────────── -->
                <DockPanel Grid.Column="1">
                    <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Classes="field" Text="{Binding Name}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     PlaceholderText="Theme name"
                                     ToolTip.Tip="The name shown in Settings. Saving writes it." />
                            <ComboBox Grid.Column="1" Classes="field" MinWidth="90" ItemsSource="{Binding BaseOptions}"
                                      SelectedItem="{Binding SelectedBase}" IsEnabled="{Binding CanEdit}"
                                      ToolTip.Tip="The palette missing colours come from, and the look of stock controls like scroll bars." />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Button Classes="ghost" Padding="10,4" Content="{Binding CopyButtonText}"
                                        Command="{Binding CopyCommand}"
                                        ToolTip.Tip="Make a copy in your themes folder that you can edit." />
                                <Button Classes="ghost" Padding="10,4" Content="Delete" IsVisible="{Binding CanEdit}"
                                        Command="{Binding DeleteCommand}" />
                                <Button Classes="ghost" Padding="10,4" Content="Use this theme"
                                        IsEnabled="{Binding CanUseTheme}"
                                        Command="{Binding UseThemeCommand}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding NameError}"
                                   IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Foreground="{DynamicResource AccentError}" FontSize="11" />
                        <Border Classes="card" Padding="10,6" IsVisible="{Binding IsReadOnly}">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMid}"
                                       Text="Built-in themes can't be changed. Customize makes a copy in your themes folder that you can edit however you like." />
                        </Border>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Classes="field" Text="{Binding SearchText}"
                                     PlaceholderText="Search tokens, sections or descriptions" />
                            <CheckBox Grid.Column="1" Content="Missing only" IsChecked="{Binding MissingOnly}"
                                      VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="ghost" Padding="10,4" Content="Undo"
                                    Command="{Binding UndoCommand}"
                                    IsVisible="{Binding CanEdit}" HotKey="Ctrl+Z"
                                    ToolTip.Tip="Undo the last colour change (Ctrl+Z)" />
                        </Grid>
                        <Border Classes="card" Padding="10,6" IsVisible="{Binding HasMissing}"
                                BorderBrush="{DynamicResource AccentCaution}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Classes="ghost" Padding="10,3"
                                        Content="Fill missing from base"
                                        Command="{Binding FillMissingCommand}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding MissingSummary}" TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextBright}" />
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{Binding UnknownKeysText}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDim}"
                                   IsVisible="{Binding UnknownKeysText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>

                    <ScrollViewer x:Name="TokenScroller">
                        <ItemsControl ItemsSource="{Binding Sections}" Margin="12,0,12,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeEditorSection">
                                    <StackPanel IsVisible="{Binding IsVisible}" Margin="0,6,0,4">
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                   Margin="0,4,0,4"
                                                   Foreground="{DynamicResource TextLabelAlt}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding VisibleRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ThemeTokenRowViewModel">
                                                    <Border Classes="token-row" Classes.missing="{Binding IsMissing}"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Tapped="OnRowTapped">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                              ColumnSpacing="8">
                                                            <Border Grid.Column="0" Width="22" Height="22"
                                                                    CornerRadius="3" BorderThickness="1"
                                                                    BorderBrush="{DynamicResource BorderStrong}"
                                                                    Background="{Binding SwatchBrush}"
                                                                    VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Key}" Classes="mono"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextBright}" />
                                                                <TextBlock Text="{Binding Description}"
                                                                           IsVisible="{Binding HasDescription}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextDim}"
                                                                           TextWrapping="Wrap" MaxLines="2"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Classes="badge" Padding="5,1"
                                                                    IsVisible="{Binding IsMissing}"
                                                                    ToolTip.Tip="Not set by this theme, so it uses the base value.">
                                                                <TextBlock Text="Missing" FontSize="10"
                                                                           Foreground="{DynamicResource AccentCaution}" />
                                                            </Border>
                                                            <TextBox Grid.Column="3" Classes="mono"
                                                                     Classes.hex-bad="{Binding !HexIsValid}"
                                                                     Width="100" MinHeight="24" Padding="6,2"
                                                                     FontSize="11" Text="{Binding Hex}"
                                                                     VerticalAlignment="Center"
                                                                     IsReadOnly="{Binding $parent[UserControl].((vm:ThemeEditorViewModel)DataContext).IsReadOnly, FallbackValue=True}"
                                                                     ToolTip.Tip="#RRGGBB or #AARRGGBB" />
                                                            <Button Grid.Column="4" Classes="ghost" Padding="6,2"
                                                                    FontSize="10" Content="Reset"
                                                                    IsEnabled="{Binding CanReset}"
                                                                    Command="{Binding ResetCommand}"
                                                                    IsVisible="{Binding $parent[UserControl].((vm:ThemeEditorViewModel)DataContext).CanEdit, FallbackValue=False}"
                                                                    ToolTip.Tip="Back to the base palette's value" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ── Picker + preview ───────────────────────────────────────── -->
                <Border Grid.Column="2" Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1,0,0,0">
                    <ScrollViewer>
                        <StackPanel Margin="12" Spacing="10">
                            <Border Classes="card" Padding="10" IsVisible="{Binding HasSelectedRow}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding SelectedRow.Key, FallbackValue=''}" Classes="mono"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBright}" />
                                    <TextBlock Text="{Binding SelectedRow.Family, FallbackValue=''}" FontSize="10"
                                               Foreground="{DynamicResource TextLabelAlt}" />
                                    <TextBlock Text="{Binding SelectedRow.Description, FallbackValue=''}" FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMid}" />
                                    <ItemsControl ItemsSource="{Binding SelectedRow.Stops, FallbackValue={x:Null}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ThemeGradientStopItem">
                                                <Button Classes="chip" Margin="0,0,4,4" Content="{Binding Label}"
                                                        CommandParameter="{Binding Index}"
                                                        Command="{Binding $parent[UserControl].((vm:ThemeEditorViewModel)DataContext).SelectStopCommand, FallbackValue={x:Null}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ColorView
                                        Color="{Binding SelectedRow.EditColor, Mode=TwoWay, FallbackValue=#00000000}"
                                        IsEnabled="{Binding CanEdit}" IsAlphaEnabled="True" IsAlphaVisible="True"
                                        IsColorPaletteVisible="False" Height="300" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <TextBlock Text="Base value" FontSize="11"
                                                   Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="mono" FontSize="11"
                                                   Foreground="{DynamicResource TextMid}"
                                                   Text="{Binding SelectedRow.BaseHex, FallbackValue=''}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="PREVIEW" Classes="sectionLabel" />
                            <ThemeVariantScope RequestedThemeVariant="{Binding PreviewVariant}">
                                <views:ThemePreviewPane />
                            </ThemeVariantScope>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ── Footer ─────────────────────────────────────────────────────── -->
            <Border Grid.Row="1" Background="{DynamicResource PanelHeaderBg}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,1,0,0" Padding="12,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Padding="12,5" Content="Save As…" Command="{Binding SaveAsCommand}"
                                ToolTip.Tip="Save these colours as a new theme" />
                        <Button Classes="primary" Padding="16,5" Content="Save" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsDirty}" />
                        <Button Classes="ghost" Padding="12,5" Content="Cancel" Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <CheckBox DockPanel.Dock="Left" Content="Apply to the app while editing"
                              IsChecked="{Binding ApplyToApp}"
                              ToolTip.Tip="Show these colours across the whole app. It goes back to your theme when this window closes without saving." />
                    <TextBlock Text="{Binding Status}" Margin="12,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextMid}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── Prompts ────────────────────────────────────────────────────────── -->
        <Border Background="{DynamicResource ModalScrim}" IsVisible="{Binding HasPrompt}">
            <Border Classes="card" Width="420" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Panel>
                    <StackPanel Spacing="12" IsVisible="{Binding IsUnsavedPrompt}">
                        <TextBlock Text="{Binding UnsavedPromptText}" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBright}" />
                        <TextBlock Text="Save them first, or discard them?" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMid}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="ghost" Padding="12,5" Content="Keep editing"
                                    Command="{Binding DismissPromptCommand}" />
                            <Button Classes="ghost" Padding="12,5" Content="Discard"
                                    Command="{Binding DiscardAndContinueCommand}" />
                            <Button Classes="primary" Padding="12,5" Content="Save"
                                    Command="{Binding SaveAndContinueCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="10" IsVisible="{Binding IsNamePrompt}">
                        <TextBlock Text="{Binding CopyPromptTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBright}" />
                        <TextBlock
                            Text="Name your theme. It's saved to your themes folder, and you can edit it however you like."
                            TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMid}" />
                        <TextBox Classes="field" Text="{Binding CopyName}" />
                        <TextBlock Text="{Binding CopyNameError}" Foreground="{DynamicResource AccentError}"
                                   FontSize="11"
                                   IsVisible="{Binding CopyNameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="ghost" Padding="12,5" Content="Cancel"
                                    Command="{Binding DismissPromptCommand}" />
                            <Button Classes="primary" Padding="12,5" Content="Create"
                                    Command="{Binding ConfirmCopyCommand}"
                                    IsEnabled="{Binding CopyNameError, Converter={x:Static ObjectConverters.IsNull}}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="12" IsVisible="{Binding IsDeletePrompt}">
                        <TextBlock Text="{Binding DeletePromptText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBright}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="ghost" Padding="12,5" Content="Keep it"
                                    Command="{Binding DismissPromptCommand}" />
                            <Button Classes="primary" Padding="12,5" Content="Delete"
                                    Command="{Binding ConfirmDeleteCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </Border>
        </Border>
    </Panel>
</UserControl>