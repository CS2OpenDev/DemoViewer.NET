<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:DemoViewer.NET.Extensions.RuleCanvas.Views"
             xmlns:vm="using:DemoViewer.NET.Extensions.RuleCanvas.ViewModels"
             xmlns:model="using:DemoViewer.NET.Extensions.RuleCanvas.Model"
             xmlns:nodify="clr-namespace:Nodify.Avalonia;assembly=Nodify.Avalonia"
             xmlns:nodes="clr-namespace:Nodify.Avalonia.Nodes;assembly=Nodify.Avalonia"
             xmlns:connections="clr-namespace:Nodify.Avalonia.Connections;assembly=Nodify.Avalonia"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="DemoViewer.NET.Extensions.RuleCanvas.Views.CanvasTabView"
             x:DataType="vm:CanvasTabViewModel">

    <!--
      THE CANVAS SECTION: a strip over a Nodify editor. The strip picks the ruleset, reports what was
      drawn and switches the node style; the editor draws the composed ruleset. A node is a header (kind pill, id, label) over chips
      (trigger, gate, scope), the match facets as rows, and the expression; its ports are value references
      only. Every colour is a token: the app's brushes on the node face, and the Nodify palette keys below
      mapped onto the same tokens so the editor's own chrome follows the theme.
    -->

    <UserControl.Styles>
        <StyleInclude Source="avares://Nodify.Avalonia/Themes/Controls.xaml" />
        <!-- A read is a dashed wire; a write is solid. -->
        <Style Selector="connections|Connection.read">
            <Setter Property="StrokeDashArray" Value="4,3" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
    </UserControl.Styles>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveSourceCommand}" />
        <KeyBinding Gesture="Cmd+S" Command="{Binding SaveSourceCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="NodifyEditor.BackgroundColor">#EFF0F7</Color>
                    <Color x:Key="NodifyEditor.ForegroundColor">#2E2E60</Color>
                    <Color x:Key="Node.BackgroundColor">#FCFCFE</Color>
                    <Color x:Key="Node.ContentColor">#FCFCFE</Color>
                    <Color x:Key="Node.HeaderColor">#E9EAF3</Color>
                    <Color x:Key="Node.BorderColor">#C9CADD</Color>
                    <Color x:Key="ItemContainer.BorderColor">#C9CADD</Color>
                    <Color x:Key="ItemContainer.SelectedColor">#4A4A9E</Color>
                    <Color x:Key="Connector.BackgroundColor">#4A4A9E</Color>
                    <Color x:Key="Connector.BorderColor">#EFF0F7</Color>
                    <Color x:Key="Connection.StrokeColor">#4A4A9E</Color>
                    <Color x:Key="PendingConnection.StrokeColor">#4A4A9E</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="NodifyEditor.BackgroundColor">#0C0C1A</Color>
                    <Color x:Key="NodifyEditor.ForegroundColor">#C0C0F0</Color>
                    <Color x:Key="Node.BackgroundColor">#171726</Color>
                    <Color x:Key="Node.ContentColor">#171726</Color>
                    <Color x:Key="Node.HeaderColor">#0E0E1E</Color>
                    <Color x:Key="Node.BorderColor">#252545</Color>
                    <Color x:Key="ItemContainer.BorderColor">#252545</Color>
                    <Color x:Key="ItemContainer.SelectedColor">#8A8AE0</Color>
                    <Color x:Key="Connector.BackgroundColor">#7A7AD6</Color>
                    <Color x:Key="Connector.BorderColor">#0C0C1A</Color>
                    <Color x:Key="Connection.StrokeColor">#7A7AD6</Color>
                    <Color x:Key="PendingConnection.StrokeColor">#7A7AD6</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- The strip, two rows: what is drawn and how it reads; then what can be done to it. -->
        <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBg}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1" Padding="12 6">
            <StackPanel Spacing="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="STYLE" FontSize="11" LetterSpacing="1" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDim}" Margin="0 0 4 0" />
                        <Button Classes="ghost" Content="Compact" FontSize="12" Padding="8 3"
                                Command="{Binding SetStyleCommand}" CommandParameter="compact"
                                IsEnabled="{Binding ShowFacets}" />
                        <Button Classes="ghost" Content="Detailed" FontSize="12" Padding="8 3"
                                Command="{Binding SetStyleCommand}" CommandParameter="detailed"
                                IsEnabled="{Binding IsCompact}" />
                        <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="6 2" />
                        <Button Classes="ghost" Content="Source" FontSize="12" Padding="8 3"
                                Command="{Binding ToggleSourceCommand}"
                                ToolTip.Tip="Show or hide the ruleset's YAML beside the canvas" />
                        <Button Classes="ghost" Content="Reset arrangement" FontSize="12" Padding="8 3"
                                Command="{Binding ResetLayoutCommand}" IsEnabled="{Binding HasSavedLayout}"
                                ToolTip.Tip="{Binding SidecarPath}" />
                        <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="6 2" />
                        <Button Classes="ghost" Content="Open Authoring" FontSize="12" Padding="8 3"
                                Command="{Binding OpenAuthoringCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="RULESET" FontSize="11" LetterSpacing="1" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDim}" />
                        <ComboBox ItemsSource="{Binding Rulesets}" SelectedItem="{Binding SelectedRuleset}"
                                  MinWidth="220" FontSize="12" Padding="8 3">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="model:RulesetCorpus+Entry">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Id}" FontFamily="monospace" />
                                        <TextBlock Text="{Binding Source}" Foreground="{DynamicResource TextDim}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMid}" VerticalAlignment="Center"
                                   Text="{Binding Status}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource AccentCaution}" VerticalAlignment="Center"
                                   IsVisible="{Binding HasDiagnostics}" Text="diagnostics" ToolTip.Tip="{Binding Diagnostics}" />
                        <TextBlock IsVisible="{Binding AuthoringUnavailable}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentCaution}"
                                   Text="The Authoring tab is not available: switched off under Settings, Features, or this build has none." />
                    </StackPanel>
                </DockPanel>

                <!-- The edit row: history, the palette, deletion, and the way into a shipped ruleset. -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="EDIT" FontSize="11" LetterSpacing="1" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDim}" Margin="0 0 4 0" />
                    <Button Classes="ghost" Content="Undo" FontSize="12" Padding="8 3" Command="{Binding UndoCommand}" />
                    <Button Classes="ghost" Content="Redo" FontSize="12" Padding="8 3" Command="{Binding RedoCommand}" />
                    <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="6 2" />
                    <ComboBox x:Name="AddStatView" PlaceholderText="Add stat on…" FontSize="12" Padding="8 3" MinWidth="140"
                              IsEnabled="{Binding IsEditable}" ItemsSource="{Binding Views}"
                              SelectionChanged="OnAddStatViewChanged" />
                    <Button Classes="ghost" Content="Delete selected" FontSize="12" Padding="8 3"
                            Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding IsEditable}"
                            ToolTip.Tip="Remove the selected node's entry from the file" />
                    <Button Classes="ghost" Content="Edit a copy" FontSize="12" Padding="8 3"
                            Command="{Binding EditCopyCommand}" IsVisible="{Binding IsShippedRuleset}"
                            ToolTip.Tip="Copy this shipped ruleset into your rules and open the copy, which overrides it" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMid}" VerticalAlignment="Center"
                               IsVisible="{Binding IsShippedRuleset}"
                               Text="A shipped ruleset is read only here. Edit a copy puts one in your rules." />
                    <TextBlock FontSize="12" Foreground="{DynamicResource AccentCaution}" VerticalAlignment="Center"
                               IsVisible="{Binding SourceDirty}" Text="Save or revert the source pane to edit on the canvas." />
                    <TextBlock FontSize="12" Foreground="{DynamicResource AccentCaution}" VerticalAlignment="Center"
                               IsVisible="{Binding HasEditStatus}" Text="{Binding EditStatus}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

        <!-- The ruleset's YAML, read-only for now; a selected node scrolls it to the line that declares it. -->
        <Border Grid.Column="1" Width="440" IsVisible="{Binding ShowSource}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1 0 0 0"
                Background="{DynamicResource PanelBg}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelHeaderBg}"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1" Padding="10 5">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                                       Text="read only" IsVisible="{Binding IsShippedRuleset}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource AccentCaution}" VerticalAlignment="Center"
                                       Text="unsaved" IsVisible="{Binding SourceDirty}" />
                            <Button Classes="ghost" Content="Save" FontSize="11" Padding="6 1"
                                    Command="{Binding SaveSourceCommand}" IsVisible="{Binding SourceDirty}" />
                            <Button Classes="ghost" Content="Revert" FontSize="11" Padding="6 1"
                                    Command="{Binding RevertSourceCommand}" IsVisible="{Binding SourceDirty}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DocumentName}" FontSize="12" FontFamily="monospace"
                                   Foreground="{DynamicResource TextValue}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ae:TextEditor x:Name="Source"
                               FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                               FontSize="12"
                               ShowLineNumbers="True"
                               IsReadOnly="{Binding IsShippedRuleset}"
                               WordWrap="False"
                               Background="{DynamicResource PanelBg}"
                               Foreground="{DynamicResource TextValue}" />
            </DockPanel>
        </Border>

        <nodify:NodifyEditor Grid.Column="0" x:Name="Editor"
                             ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}"
                             SelectedItems="{Binding SelectedNodes}"
                             ItemsDragCompletedCommand="{Binding SaveLayoutCommand}">

            <!-- Graph position lives on the node view model; the container writes it back on drag. -->
            <nodify:NodifyEditor.ItemContainerTheme>
                <ControlTheme TargetType="nodify:ItemContainer" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
                    <Setter Property="Location" Value="{ReflectionBinding Location, Mode=TwoWay}" />
                </ControlTheme>
            </nodify:NodifyEditor.ItemContainerTheme>

            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate x:DataType="vm:CanvasConnectionViewModel">
                    <views:LabelledConnection Source="{Binding Source.Anchor}"
                                              Target="{Binding Target.Anchor}"
                                              SourceOrientation="Horizontal"
                                              TargetOrientation="Horizontal"
                                              StrokeThickness="2"
                                              ArrowEnds="End" ArrowSize="7,7"
                                              Text="{Binding Text}" FontSize="10" FontFamily="monospace"
                                              Foreground="{DynamicResource TextMid}"
                                              TextBackground="{DynamicResource PanelBg}"
                                              TextPadding="5 1" TextCornerRadius="3"
                                              Classes.read="{Binding IsRead}"
                                              ToolTip.Tip="{Binding Condition}" />
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate x:DataType="vm:CanvasNodeViewModel">
                    <nodes:Node Input="{Binding Inputs}" Output="{Binding Outputs}" ContentPadding="10 6 10 8"
                                ContentBrush="{DynamicResource CardBg}" HeaderBrush="{DynamicResource PanelHeaderBg}">

                        <!-- Header: the kind pill, the id, and the label when there is one. -->
                        <nodes:Node.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2 1">
                                <Border CornerRadius="3" Padding="5 1" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentInteractive}" IsVisible="{Binding !IsScaffold}">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="9" FontWeight="SemiBold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextOnAccent}" />
                                </Border>
                                <!-- An engine node's pill is outlined rather than filled: not the author's. -->
                                <Border CornerRadius="3" Padding="5 1" VerticalAlignment="Center" BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderAccent}" IsVisible="{Binding IsScaffold}">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="9" FontWeight="SemiBold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMid}" />
                                </Border>
                                <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="SemiBold" FontFamily="monospace"
                                           Foreground="{DynamicResource TextCardHeader}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextMid}"
                                           VerticalAlignment="Center" IsVisible="{Binding Label, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </nodes:Node.Header>

                        <nodes:Node.InputConnectorTemplate>
                            <DataTemplate x:DataType="vm:CanvasConnectorViewModel">
                                <nodes:NodeInput Header="{Binding Title}" FontSize="11" FontFamily="monospace"
                                                 Foreground="{DynamicResource TextValue}"
                                                 Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                 IsConnected="{Binding IsConnected}" />
                            </DataTemplate>
                        </nodes:Node.InputConnectorTemplate>

                        <nodes:Node.OutputConnectorTemplate>
                            <DataTemplate x:DataType="vm:CanvasConnectorViewModel">
                                <nodes:NodeOutput Header="{Binding Title}" FontSize="11" FontFamily="monospace"
                                                  Foreground="{DynamicResource TextValue}"
                                                  Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                  IsConnected="{Binding IsConnected}" />
                            </DataTemplate>
                        </nodes:Node.OutputConnectorTemplate>

                        <!-- Face: chips, then the facet rows (detailed) or their count (compact), then the expression. -->
                        <StackPanel Spacing="6" MinWidth="180" PointerPressed="OnFacePressed">
                            <ItemsControl ItemsSource="{Binding Chips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border CornerRadius="9" Padding="7 1" Margin="0 0 4 2"
                                                Background="{DynamicResource PanelBg}"
                                                BorderBrush="{DynamicResource BorderAccent}" BorderThickness="1">
                                            <TextBlock Text="{Binding}" FontSize="10" FontFamily="monospace"
                                                       Foreground="{DynamicResource TextMid}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Facets}" IsVisible="{Binding ShowFacets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CanvasFacetViewModel">
                                        <!-- A row: the name, then the editor the catalog type calls for. Read-only
                                             nodes show the written value as text. -->
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0 1" MinHeight="18">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" FontFamily="monospace"
                                                       Foreground="{DynamicResource TextMid}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" FontFamily="monospace"
                                                       Foreground="{DynamicResource TextValue}" VerticalAlignment="Center"
                                                       IsVisible="{Binding !IsEditable}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsEditable}">
                                                <CheckBox IsChecked="{Binding Toggle}" IsThreeState="False" IsVisible="{Binding IsBool}"
                                                          MinHeight="0" Padding="0" Margin="0" />
                                                <ComboBox ItemsSource="{x:Static vm:CanvasFacetViewModel.Comparators}"
                                                          SelectedItem="{Binding Comparator}" IsVisible="{Binding IsNumber}"
                                                          FontSize="11" MinWidth="52" Padding="4 1" />
                                                <TextBox Text="{Binding Literal}" IsVisible="{Binding !IsBool}" FontSize="11"
                                                         FontFamily="monospace" MinWidth="60" Padding="4 1" MinHeight="0"
                                                         LostFocus="OnFacetEditorLostFocus">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="ghost" Content="×" FontSize="11" Padding="4 0" MinHeight="0"
                                                    Command="{Binding RemoveCommand}" IsVisible="{Binding IsEditable}"
                                                    ToolTip.Tip="Remove this facet" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Adding a facet the view offers and the document does not bind yet. -->
                            <ComboBox ItemsSource="{Binding AvailableFacets}" SelectedItem="{Binding FacetToAdd}"
                                      PlaceholderText="add facet…" FontSize="11" Padding="6 1" MinHeight="0"
                                      IsVisible="{Binding IsEditable}" />

                            <!-- What the composition said about this entry. -->
                            <Border Background="{DynamicResource AccentCaution}" CornerRadius="3" Padding="6 2"
                                    IsVisible="{Binding HasDiagnostics}" ToolTip.Tip="{Binding DiagnosticsText}">
                                <TextBlock Text="{Binding DiagnosticsText}" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextOnAccent}" />
                            </Border>

                            <TextBlock Text="{Binding FacetSummary}" FontSize="11" Foreground="{DynamicResource TextDim}"
                                       IsVisible="{Binding ShowFacetSummary}" />

                            <TextBlock Text="{Binding Expression}" FontSize="11" FontFamily="monospace" MaxWidth="340"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextValue}" IsVisible="{Binding HasExpression}" />
                        </StackPanel>
                    </nodes:Node>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>
        </nodify:NodifyEditor>
        </Grid>
    </Grid>
</UserControl>
