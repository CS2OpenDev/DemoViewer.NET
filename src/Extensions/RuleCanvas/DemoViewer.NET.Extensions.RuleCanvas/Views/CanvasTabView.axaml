<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:DemoViewer.NET.Extensions.RuleCanvas.Views"
             xmlns:vm="using:DemoViewer.NET.Extensions.RuleCanvas.ViewModels"
             xmlns:model="using:DemoViewer.NET.Extensions.RuleCanvas.Model"
             xmlns:nodify="clr-namespace:Nodify.Avalonia;assembly=Nodify.Avalonia"
             xmlns:nodes="clr-namespace:Nodify.Avalonia.Nodes;assembly=Nodify.Avalonia"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="DemoViewer.NET.Extensions.RuleCanvas.Views.CanvasTabView"
             x:DataType="vm:CanvasTabViewModel">

    <!--
      THE CANVAS SECTION: a strip over a Nodify editor. The strip picks the ruleset, reports what was
      drawn and switches the node style; the editor draws the composed ruleset. A node is a header (kind pill, id, label) over chips
      (trigger, gate, scope), the match facets as rows, and the expression; its ports are value references
      only. Every colour is a token: the app's brushes on the node face, and the Nodify palette in
      CanvasTheme.axaml mapped onto the same tokens so the editor's own chrome follows the theme.
    -->

    <UserControl.Styles>
        <StyleInclude Source="avares://Nodify.Avalonia/Themes/Controls.xaml" />
        <StyleInclude Source="avares://DemoViewer.NET.Extensions.RuleCanvas/Views/CanvasTheme.axaml" />
    </UserControl.Styles>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveSourceCommand}" />
        <KeyBinding Gesture="Cmd+S" Command="{Binding SaveSourceCommand}" />
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto,*">

        <!-- The strip, two rows: what is drawn and how it reads; then what can be done to it. -->
        <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBg}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1" Padding="12 6">
            <StackPanel Spacing="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="STYLE" FontSize="11" LetterSpacing="1" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDim}" Margin="0 0 4 0" />
                        <Button Classes="ghost" Content="Compact" FontSize="12" Padding="8 3"
                                Command="{Binding SetStyleCommand}" CommandParameter="compact"
                                IsEnabled="{Binding ShowFacets}" />
                        <Button Classes="ghost" Content="Detailed" FontSize="12" Padding="8 3"
                                Command="{Binding SetStyleCommand}" CommandParameter="detailed"
                                IsEnabled="{Binding IsCompact}" />
                        <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="6 2" />
                        <Button Classes="ghost" Content="Focus selected" FontSize="12" Padding="8 3"
                                Command="{Binding FocusSelectedCommand}"
                                ToolTip.Tip="Draw only the selected node's slice of the chain: what feeds it and what it feeds" />
                        <Border CornerRadius="3" Padding="6 1" VerticalAlignment="Center" IsVisible="{Binding HasFocus}"
                                Background="{DynamicResource AccentInteractive}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding FocusLabel}" FontSize="11" FontFamily="monospace"
                                           Foreground="{DynamicResource TextOnAccent}" VerticalAlignment="Center" />
                                <Button Content="×" FontSize="11" Padding="2 0" MinHeight="0" Background="Transparent"
                                        BorderThickness="0" Foreground="{DynamicResource TextOnAccent}"
                                        Command="{Binding ClearFocusCommand}" ToolTip.Tip="Show the whole chain again" />
                            </StackPanel>
                        </Border>
                        <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="6 2" />
                        <Button Classes="ghost" Content="Gallery" FontSize="12" Padding="8 3" Command="{Binding ToggleGalleryCommand}"
                            ToolTip.Tip="Show or hide the gallery of stats, views, gates and prefabs" />
                    <Button Classes="ghost" Content="Source" FontSize="12" Padding="8 3"
                                Command="{Binding ToggleSourceCommand}"
                                ToolTip.Tip="Show or hide the ruleset's YAML beside the canvas" />
                        <Button Classes="ghost" Content="Reset arrangement" FontSize="12" Padding="8 3"
                                Command="{Binding ResetLayoutCommand}" IsEnabled="{Binding HasSavedLayout}"
                                ToolTip.Tip="{Binding SidecarPath}" />
                        <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="6 2" />
                        <Button Classes="ghost" Content="Open Authoring" FontSize="12" Padding="8 3"
                                Command="{Binding OpenAuthoringCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="RULESET" FontSize="11" LetterSpacing="1" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDim}" />
                        <ComboBox ItemsSource="{Binding Rulesets}" SelectedItem="{Binding SelectedRuleset}"
                                  MinWidth="220" FontSize="12" Padding="8 3">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="model:RulesetCorpus+Entry">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Id}" FontFamily="monospace" />
                                        <TextBlock Text="{Binding Source}" Foreground="{DynamicResource TextDim}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMid}" VerticalAlignment="Center"
                                   Text="{Binding Status}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource AccentCaution}" VerticalAlignment="Center"
                                   IsVisible="{Binding HasDiagnostics}" Text="diagnostics" ToolTip.Tip="{Binding Diagnostics}" />
                        <TextBlock IsVisible="{Binding AuthoringUnavailable}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentCaution}"
                                   Text="The Authoring tab is not available: switched off under Settings, Features, or this build has none." />
                    </StackPanel>
                </DockPanel>

                <!-- The edit row: history, the palette, deletion, and the way into a shipped ruleset. -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="EDIT" FontSize="11" LetterSpacing="1" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDim}" Margin="0 0 4 0" />
                    <Button Classes="ghost" Content="Undo" FontSize="12" Padding="8 3" Command="{Binding UndoCommand}" />
                    <Button Classes="ghost" Content="Redo" FontSize="12" Padding="8 3" Command="{Binding RedoCommand}" />
                    <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="6 2" />
                    <ComboBox x:Name="AddStatView" PlaceholderText="Add stat on…" FontSize="12" Padding="8 3" MinWidth="140"
                              IsEnabled="{Binding IsEditable}" ItemsSource="{Binding Views}"
                              SelectionChanged="OnAddStatViewChanged" />
                    <Button Classes="ghost" Content="Delete selected" FontSize="12" Padding="8 3"
                            Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding IsEditable}"
                            ToolTip.Tip="Remove the selected node's entry from the file" />
                    <Button Classes="ghost" Content="Edit a copy" FontSize="12" Padding="8 3"
                            Command="{Binding EditCopyCommand}" IsVisible="{Binding IsShippedRuleset}"
                            ToolTip.Tip="Copy this shipped ruleset into your rules and open the copy, which overrides it" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMid}" VerticalAlignment="Center"
                               IsVisible="{Binding IsShippedRuleset}"
                               Text="A shipped ruleset is read only here. Edit a copy puts one in your rules." />
                    <TextBlock FontSize="12" Foreground="{DynamicResource AccentCaution}" VerticalAlignment="Center"
                               IsVisible="{Binding SourceDirty}" Text="Save or revert the source pane to edit on the canvas." />
                    <TextBlock FontSize="12" Foreground="{DynamicResource AccentCaution}" VerticalAlignment="Center"
                               IsVisible="{Binding HasEditStatus}" Text="{Binding EditStatus}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">

            <!-- The gallery: drag a stat, a view or a prefab onto the canvas, a view or a gate onto a stat. -->
            <Border Grid.Column="0" Width="210" IsVisible="{Binding ShowGallery}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 1 0"
                    Background="{DynamicResource PanelBg}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelHeaderBg}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1" Padding="10 5">
                        <TextBlock Text="GALLERY" FontSize="11" LetterSpacing="1" Foreground="{DynamicResource TextDim}" />
                    </Border>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Gallery}" Margin="8 6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="model:GalleryGroup">
                                    <StackPanel Spacing="2" Margin="0 0 0 10">
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMid}" Margin="2 0 0 3" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="model:GalleryItem">
                                                    <Border Classes="galleryItem" CornerRadius="4" Padding="7 3" Margin="0 1"
                                                            Background="{DynamicResource CardBg}"
                                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                            Cursor="Hand" ToolTip.Tip="{Binding Hint}"
                                                            PointerPressed="OnGalleryItemPressed">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Border CornerRadius="3" Padding="4 0" VerticalAlignment="Center" BorderThickness="1"
                                                                    BorderBrush="{DynamicResource BorderAccent}">
                                                                <TextBlock Text="{Binding KindLabel}" FontSize="8" LetterSpacing="1"
                                                                           Foreground="{DynamicResource TextDim}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontFamily="monospace"
                                                                       Foreground="{DynamicResource TextValue}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        <!-- The ruleset's YAML, read-only for now; a selected node scrolls it to the line that declares it. -->
        <Border Grid.Column="2" Width="440" IsVisible="{Binding ShowSource}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1 0 0 0"
                Background="{DynamicResource PanelBg}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelHeaderBg}"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1" Padding="10 5">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                                       Text="read only" IsVisible="{Binding IsShippedRuleset}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource AccentCaution}" VerticalAlignment="Center"
                                       Text="unsaved" IsVisible="{Binding SourceDirty}" />
                            <Button Classes="ghost" Content="Save" FontSize="11" Padding="6 1"
                                    Command="{Binding SaveSourceCommand}" IsVisible="{Binding SourceDirty}" />
                            <Button Classes="ghost" Content="Revert" FontSize="11" Padding="6 1"
                                    Command="{Binding RevertSourceCommand}" IsVisible="{Binding SourceDirty}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DocumentName}" FontSize="12" FontFamily="monospace"
                                   Foreground="{DynamicResource TextValue}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ae:TextEditor x:Name="Source"
                               FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                               FontSize="12"
                               ShowLineNumbers="True"
                               IsReadOnly="{Binding IsShippedRuleset}"
                               WordWrap="False"
                               Background="{DynamicResource PanelBg}"
                               Foreground="{DynamicResource TextValue}" />
            </DockPanel>
        </Border>

        <nodify:NodifyEditor Grid.Column="1" x:Name="Editor" DragDrop.AllowDrop="True"
                             ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}"
                             SelectedItems="{Binding SelectedNodes}"
                             ItemsDragCompletedCommand="{Binding SaveLayoutCommand}"
                             ConnectionCompletedCommand="{Binding ConnectCommand}"
                             RemoveConnectionCommand="{Binding DisconnectCommand}">

            <!-- Graph position lives on the node view model; the container writes it back on drag. -->
            <nodify:NodifyEditor.ItemContainerTheme>
                <ControlTheme TargetType="nodify:ItemContainer" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
                    <Setter Property="Location" Value="{ReflectionBinding Location, Mode=TwoWay}" />
                </ControlTheme>
            </nodify:NodifyEditor.ItemContainerTheme>

            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate x:DataType="vm:CanvasConnectionViewModel">
                    <views:LabelledConnection Source="{Binding Source.Anchor}"
                                              Target="{Binding Target.Anchor}"
                                              SourceOrientation="Horizontal"
                                              TargetOrientation="Horizontal"
                                              StrokeThickness="2"
                                              ArrowEnds="End" ArrowSize="7,7"
                                              Text="{Binding Text}" FontSize="10" FontFamily="monospace"
                                              Foreground="{DynamicResource TextMid}"
                                              TextBackground="{DynamicResource PanelBg}"
                                              TextPadding="5 1" TextCornerRadius="3"
                                              Classes.read="{Binding IsRead}"
                                              Classes.gate="{Binding IsGate}"
                                              ToolTip.Tip="{Binding Condition}" />
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate x:DataType="vm:CanvasNodeViewModel">
                    <nodes:Node Input="{Binding Inputs}" Output="{Binding Outputs}" ContentPadding="10 6 10 8"
                                ContentBrush="{DynamicResource CardBg}" HeaderBrush="{DynamicResource PanelHeaderBg}">

                        <!-- Header: the kind pill, the id, and the label when there is one. On an editable stat the label
                             is click-to-edit, and an absent one can be added. -->
                        <nodes:Node.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2 1" PointerPressed="OnFacePressed">
                                <Border CornerRadius="3" Padding="5 1" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentInteractive}" IsVisible="{Binding !IsScaffold}">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="9" FontWeight="SemiBold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextOnAccent}" />
                                </Border>
                                <!-- An engine node's pill is outlined rather than filled: not the author's. -->
                                <Border CornerRadius="3" Padding="5 1" VerticalAlignment="Center" BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderAccent}" IsVisible="{Binding IsScaffold}">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="9" FontWeight="SemiBold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMid}" />
                                </Border>
                                <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="SemiBold" FontFamily="monospace"
                                           Foreground="{DynamicResource TextCardHeader}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextMid}"
                                           VerticalAlignment="Center" IsVisible="{Binding ShowLabelText}" />
                                <Button Classes="ghost" Content="✎" FontSize="10" Padding="3 0" MinHeight="0" VerticalAlignment="Center"
                                        Command="{Binding BeginEditLabelCommand}" ToolTip.Tip="Edit the label"
                                        IsVisible="{Binding CanEditLabel}" />
                                <TextBox Text="{Binding LabelText}" Watermark="label" FontSize="11" MinWidth="90" Padding="4 1" MinHeight="0"
                                         IsVisible="{Binding ShowLabelEditor}"
                                         views:FaceBehaviors.CommitOnLostFocus="{Binding CommitLabelCommand}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding CommitLabelCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                            </StackPanel>
                        </nodes:Node.Header>

                        <nodes:Node.InputConnectorTemplate>
                            <DataTemplate x:DataType="vm:CanvasConnectorViewModel">
                                <nodes:NodeInput Header="{Binding Title}" FontSize="11" FontFamily="monospace"
                                                 Foreground="{DynamicResource TextValue}"
                                                 Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                 IsConnected="{Binding IsConnected}" />
                            </DataTemplate>
                        </nodes:Node.InputConnectorTemplate>

                        <nodes:Node.OutputConnectorTemplate>
                            <DataTemplate x:DataType="vm:CanvasConnectorViewModel">
                                <nodes:NodeOutput Header="{Binding Title}" FontSize="11" FontFamily="monospace"
                                                  Foreground="{DynamicResource TextValue}"
                                                  Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                  IsConnected="{Binding IsConnected}" />
                            </DataTemplate>
                        </nodes:Node.OutputConnectorTemplate>

                        <!-- Face: chips, then the kind's own rows, the facet rows (detailed) or their count (compact),
                             then the expression. Every row the engine adds on its own is drawn dimmed, never hidden. -->
                        <StackPanel Spacing="6" MinWidth="180" PointerPressed="OnFacePressed">
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding VisibleChipItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CanvasChip">
                                            <Border CornerRadius="9" Padding="7 1" Margin="0 0 4 2"
                                                    Background="{DynamicResource PanelBg}"
                                                    BorderBrush="{DynamicResource BorderAccent}" BorderThickness="1"
                                                    ToolTip.Tip="{Binding Tip}">
                                                <TextBlock Text="{Binding Text}" FontSize="10" FontFamily="monospace"
                                                           Foreground="{DynamicResource TextMid}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- The engine's defaults the document leaves implicit, dimmed so they read as not written. -->
                                <ItemsControl ItemsSource="{Binding Defaults}" IsVisible="{Binding HasDefaults}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border CornerRadius="9" Padding="7 1" Margin="0 0 4 2"
                                                    BorderBrush="{DynamicResource TextDim}" BorderThickness="1"
                                                    ToolTip.Tip="The engine's default; the document does not write this key">
                                                <TextBlock Text="{Binding}" FontSize="10" FontFamily="monospace"
                                                           Foreground="{DynamicResource TextDim}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>

                            <!-- The trigger as a picker while editable: the spelling the author wrote, over the catalog's
                                 views by event, the raw events and the document's defines. -->
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowTriggerPicker}">
                                <TextBlock Text="on" FontSize="10" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Trigger.Options}" SelectedItem="{Binding Trigger.Selected}"
                                          PlaceholderText="pick a trigger…" FontSize="11" MinWidth="190" Padding="6 1" MinHeight="0"
                                          ToolTip.Tip="{Binding Trigger.Tip}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="model:TriggerOption">
                                            <TextBlock Text="{Binding Display}" FontSize="11" FontFamily="monospace" ToolTip.Tip="{Binding Tip}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- The view's per-player binding, switched off by match: { actor: any }. -->
                            <CheckBox IsChecked="{Binding BindsActor}" IsThreeState="False" Content="bind to this player" FontSize="11"
                                      MinHeight="0" Padding="4 0" IsVisible="{Binding ShowActorToggle}"
                                      ToolTip.Tip="Off writes match: { actor: any }, so every player's event counts" />

                            <!-- Rows the engine adds and the author cannot remove, stated so the face says what runs. -->
                            <ItemsControl ItemsSource="{Binding FixedRows}" IsVisible="{Binding HasFixedRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="11" FontFamily="monospace" Margin="0 1"
                                                   Foreground="{DynamicResource TextDim}"
                                                   ToolTip.Tip="Baked into the view: event.Attacker != event.UserId" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Facets}" IsVisible="{Binding ShowFacets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CanvasFacetViewModel">
                                        <!-- A row: the name, then the editor the catalog type calls for. Read-only
                                             nodes show the written value as text. -->
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0 1" MinHeight="18">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" FontFamily="monospace"
                                                       Foreground="{DynamicResource TextMid}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" FontFamily="monospace"
                                                       Foreground="{DynamicResource TextValue}" VerticalAlignment="Center"
                                                       IsVisible="{Binding !IsEditable}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsEditable}">
                                                <CheckBox IsChecked="{Binding Toggle}" IsThreeState="False" IsVisible="{Binding IsBool}"
                                                          MinHeight="0" Padding="0" Margin="0" />
                                                <ComboBox ItemsSource="{x:Static vm:CanvasFacetViewModel.Comparators}"
                                                          SelectedItem="{Binding Comparator}" IsVisible="{Binding IsNumber}"
                                                          FontSize="11" MinWidth="52" Padding="4 1" />
                                                <TextBox Text="{Binding Literal}" IsVisible="{Binding !IsBool}" FontSize="11"
                                                         FontFamily="monospace" MinWidth="60" Padding="4 1" MinHeight="0"
                                                         LostFocus="OnFacetEditorLostFocus">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="ghost" Content="×" FontSize="11" Padding="4 0" MinHeight="0"
                                                    Command="{Binding RemoveCommand}" IsVisible="{Binding IsEditable}"
                                                    ToolTip.Tip="Remove this facet" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Adding a facet the view offers and the document does not bind yet. -->
                            <ComboBox ItemsSource="{Binding AvailableFacets}" SelectedItem="{Binding FacetToAdd}"
                                      PlaceholderText="add facet…" FontSize="11" Padding="6 1" MinHeight="0"
                                      IsVisible="{Binding ShowFacetPicker}" />

                            <!-- The kind's own free-text keys: a sum's value, a streak's window, a rate's buckets. The
                                 editor is a combo over the suggestions that takes any text; a locked value is shown only. -->
                            <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding HasFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CanvasFieldViewModel">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0 1" MinHeight="18">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="10" MinWidth="34"
                                                       Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding ReadText}" FontSize="11" FontFamily="monospace"
                                                       TextWrapping="Wrap" MaxWidth="340" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextValue}" IsVisible="{Binding !CanEdit}"
                                                       ToolTip.Tip="{Binding LockedReason}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.dim">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                                                    </Style>
                                                </TextBlock.Styles>
                                                <Classes.dim>
                                                    <Binding Path="ShowsDefault" />
                                                </Classes.dim>
                                            </TextBlock>
                                            <ComboBox Grid.Column="1" IsEditable="True" Text="{Binding Text}" ItemsSource="{Binding Suggestions}"
                                                      SelectedItem="{Binding Picked}" PlaceholderText="{Binding Placeholder}"
                                                      FontSize="11" FontFamily="monospace" MinWidth="200" MaxWidth="340" Padding="4 1" MinHeight="0"
                                                      IsVisible="{Binding CanEdit}"
                                                      views:FaceBehaviors.CommitOnLostFocus="{Binding CommitCommand}">
                                                <ComboBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                                                </ComboBox.KeyBindings>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The kind's closed-set keys: keep, format, reduce, a highlight's kind. The first entry is the default. -->
                            <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding HasChoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CanvasChoiceViewModel">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0 1" MinHeight="18">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="10" MinWidth="34"
                                                       Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding ReadText}" FontSize="11" FontFamily="monospace"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextValue}"
                                                       IsVisible="{Binding !IsEditable}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock.dim">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                                                    </Style>
                                                </TextBlock.Styles>
                                                <Classes.dim>
                                                    <Binding Path="IsDefault" />
                                                </Classes.dim>
                                            </TextBlock>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                                      FontSize="11" MinWidth="120" Padding="6 1" MinHeight="0" IsVisible="{Binding IsEditable}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CanvasChoice">
                                                        <TextBlock Text="{Binding Display}" FontSize="11" FontFamily="monospace" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- A tally's thresholds as a table: the minimum and the counter it increments, one row each. -->
                            <StackPanel Spacing="2" IsVisible="{Binding HasThresholds}">
                                <TextBlock Text="thresholds" FontSize="10" Foreground="{DynamicResource TextDim}" />
                                <ItemsControl ItemsSource="{Binding Thresholds.Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CanvasThresholdRowViewModel">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6" Margin="0 1" MinHeight="18">
                                                <TextBlock Grid.Column="0" Text="{Binding Min}" FontSize="11" FontFamily="monospace" MinWidth="30"
                                                           Foreground="{DynamicResource TextValue}" VerticalAlignment="Center"
                                                           IsVisible="{Binding !IsEditable}" />
                                                <TextBox Grid.Column="0" Text="{Binding Min}" FontSize="11" FontFamily="monospace" MinWidth="48"
                                                         Padding="4 1" MinHeight="0" IsVisible="{Binding IsEditable}"
                                                         views:FaceBehaviors.CommitOnLostFocus="{Binding CommitCommand}">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <TextBlock Grid.Column="1" Text="→" FontSize="11" Foreground="{DynamicResource TextDim}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Target}" FontSize="11" FontFamily="monospace"
                                                           Foreground="{DynamicResource TextValue}" VerticalAlignment="Center"
                                                           IsVisible="{Binding !IsEditable}" />
                                                <TextBox Grid.Column="2" Text="{Binding Target}" FontSize="11" FontFamily="monospace" MinWidth="120"
                                                         Padding="4 1" MinHeight="0" IsVisible="{Binding IsEditable}"
                                                         views:FaceBehaviors.CommitOnLostFocus="{Binding CommitCommand}">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <Button Grid.Column="3" Classes="ghost" Content="×" FontSize="11" Padding="4 0" MinHeight="0"
                                                        Command="{Binding RemoveCommand}" IsVisible="{Binding IsEditable}"
                                                        ToolTip.Tip="Remove this threshold" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="ghost" Content="+ threshold" FontSize="10" Padding="4 0" MinHeight="0" HorizontalAlignment="Left"
                                        Command="{Binding Thresholds.AddCommand}" IsVisible="{Binding Thresholds.IsEditable}" />
                            </StackPanel>

                            <!-- What the composition said about this entry. -->
                            <Border Background="{DynamicResource AccentCaution}" CornerRadius="3" Padding="6 2"
                                    IsVisible="{Binding HasDiagnostics}" ToolTip.Tip="{Binding DiagnosticsText}">
                                <TextBlock Text="{Binding DiagnosticsText}" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextOnAccent}" />
                            </Border>

                            <TextBlock Text="{Binding FacetSummary}" FontSize="11" Foreground="{DynamicResource TextDim}"
                                       IsVisible="{Binding ShowFacetSummary}" />

                            <!-- The scope and the gate as pickers while editable; chips otherwise. The gate editor lists the
                                 context paths and the ruleset's flags and takes any text the file could hold. -->
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowFieldPickers}">
                                <TextBlock Text="per" FontSize="10" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{x:Static vm:CanvasNodeViewModel.PerOptions}" SelectedItem="{Binding Per}"
                                          PlaceholderText="round (default)" PlaceholderForeground="{DynamicResource TextDim}"
                                          FontSize="11" MinWidth="76" Padding="6 1" MinHeight="0" />
                                <TextBlock Text="while" FontSize="10" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                                           IsVisible="{Binding ShowGatePicker}" />
                                <ComboBox ItemsSource="{Binding GateChoices}" SelectedItem="{Binding GateChoice}" IsEditable="True"
                                          Text="{Binding GateText}" PlaceholderText="none" FontSize="11" FontFamily="monospace"
                                          MinWidth="150" Padding="6 1" MinHeight="0" IsVisible="{Binding ShowGatePicker}"
                                          ToolTip.Tip="A context path, a sibling flag, or any gate expression the file can hold"
                                          views:FaceBehaviors.CommitOnLostFocus="{Binding CommitGateCommand}">
                                    <ComboBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding CommitGateCommand}" />
                                    </ComboBox.KeyBindings>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Text="{Binding Expression}" FontSize="11" FontFamily="monospace" MaxWidth="340"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextValue}" IsVisible="{Binding ShowExpressionText}" />

                            <!-- The where:, when: and compute: text as editors while editable. -->
                            <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding ShowLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CanvasExpressionViewModel">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0 1">
                                            <TextBlock Grid.Column="0" Text="{Binding Prefix}" FontSize="10" MinWidth="34"
                                                       Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding Text}" Watermark="{Binding Placeholder}"
                                                     FontSize="11" FontFamily="monospace" MinWidth="200" MaxWidth="340" Padding="4 1" MinHeight="0"
                                                     TextWrapping="Wrap" AcceptsReturn="False" LostFocus="OnExpressionLostFocus">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </nodes:Node>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>
        </nodify:NodifyEditor>
        </Grid>
    </Grid>
</UserControl>
