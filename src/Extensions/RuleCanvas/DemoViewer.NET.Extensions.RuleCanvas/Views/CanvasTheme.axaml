<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nodify="clr-namespace:Nodify.Avalonia;assembly=Nodify.Avalonia"
        xmlns:nodes="clr-namespace:Nodify.Avalonia.Nodes;assembly=Nodify.Avalonia"
        xmlns:connections="clr-namespace:Nodify.Avalonia.Connections;assembly=Nodify.Avalonia"
        xmlns:views="using:DemoViewer.NET.Extensions.RuleCanvas.Views">

    <!--
      THE CANVAS THEME: the canvas's own tokens (Rule*) in both themes, and every piece of Nodify chrome
      restyled to read them, so nothing on the canvas falls back to Nodify's DodgerBlue and Orange. Included by
      CanvasTabView after Nodify's own control styles; later styles win, so the ControlTheme keys below replace
      Nodify's. A token that mirrors a host token carries the host's value for that theme and says so; the
      extension keeps its own copy because a resource cannot alias one key to another across the host boundary.
      The catalogue, with the measured contrasts, is in docs/ui/design-system.md under "Rule Canvas tokens".
    -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Node kinds: text and the header stripe, measured against RuleNodeBg. -->
                    <SolidColorBrush x:Key="RuleKindEvent" Color="#795E26" />
                    <SolidColorBrush x:Key="RuleKindEnrich" Color="#00796B" />
                    <SolidColorBrush x:Key="RuleKindContext" Color="#1565C0" />
                    <SolidColorBrush x:Key="RuleKindStat" Color="#0070C1" />
                    <SolidColorBrush x:Key="RuleKindDerived" Color="#AF00DB" />
                    <SolidColorBrush x:Key="RuleKindHighlight" Color="#A8470A" />
                    <SolidColorBrush x:Key="RuleKindDefine" Color="#2E6B4F" />
                    <SolidColorBrush x:Key="RuleKindSurface" Color="#546E7A" />
                    <SolidColorBrush x:Key="RuleKindDependency" Color="#6A4FA3" />
                    <!-- Wire meanings, non-text, measured against RuleCanvasBg. -->
                    <SolidColorBrush x:Key="RuleWireWrite" Color="#5A5E7C" />
                    <SolidColorBrush x:Key="RuleWireRead" Color="#50507C" />
                    <SolidColorBrush x:Key="RuleWireGate" Color="#1565C0" />
                    <SolidColorBrush x:Key="RuleWireAnd" Color="#2E7D32" />
                    <SolidColorBrush x:Key="RuleWireOr" Color="#B45309" />
                    <!-- Surfaces and chrome. -->
                    <SolidColorBrush x:Key="RuleCanvasBg" Color="#EFF0F7" />
                    <SolidColorBrush x:Key="RuleNodeBg" Color="#FCFCFE" />
                    <SolidColorBrush x:Key="RuleNodeBorder" Color="#A8AAC4" />
                    <SolidColorBrush x:Key="RuleSelection" Color="#4A4A9E" />
                    <SolidColorBrush x:Key="RuleSelectionFill" Color="#264A4A9E" />
                    <SolidColorBrush x:Key="RuleCutLine" Color="#C62828" />
                    <SolidColorBrush x:Key="RuleMinimapBg" Color="#E9EAF3" />
                    <SolidColorBrush x:Key="RuleTextKey" Color="#3C3C70" />
                    <!-- The halo under a hovered or selected wire; the alpha is in the token so the composite is measured. -->
                    <SolidColorBrush x:Key="RuleWireHalo" Color="#B34A4A9E" />
                    <!-- The tick in a checked face checkbox, on RuleSelection: TextOnAccent is 2.44 there in light. -->
                    <SolidColorBrush x:Key="RuleCheckGlyph" Color="#FCFCFE" />
                    <!-- 10px text on an AccentError or RuleDiagnosticWarning badge; TextOnAccent is 3.30 on the light error red. -->
                    <SolidColorBrush x:Key="RuleDiagnosticBadgeText" Color="#FCFCFE" />
                    <!-- A warning badge: the engine tolerated it, so amber beside the error red, dark enough for the badge text. -->
                    <SolidColorBrush x:Key="RuleDiagnosticWarning" Color="#A15C00" />
                    <!-- The live value badge in the node header: a tint off RuleNodeBg, and the grey its text takes
                         when the run predates the text drawn. -->
                    <SolidColorBrush x:Key="RuleLiveBadgeBg" Color="#E6E7F3" />
                    <SolidColorBrush x:Key="RuleLiveStale" Color="#7E8099" />
                    <!-- The halo under a wire that fired at a stepped tick, for 300 ms: the or hue with its own alpha,
                         so it reads apart from the selection halo. -->
                    <SolidColorBrush x:Key="RuleWireFlash" Color="#D9B45309" />
                    <!-- A frame around nodes: a translucent fill off the selection hue so the canvas and the wires
                         show through, a header one step denser, and a border that reads as chrome, not as a kind. -->
                    <SolidColorBrush x:Key="RuleGroupFill" Color="#144A4A9E" />
                    <SolidColorBrush x:Key="RuleGroupHeaderBg" Color="#2E4A4A9E" />
                    <SolidColorBrush x:Key="RuleGroupBorder" Color="#8E90B4" />
                    <!-- Minimap items are the kind tokens, which are tuned for text on the face; at full strength
                         on the light minimap they shout, so light draws them at 55%. -->
                    <x:Double x:Key="RuleMinimapItemOpacity">0.55</x:Double>
                    <!-- Nodify's own brush keys, aliased onto the tokens: its control themes read these by key, and a
                         node with a header takes them over a brush set on the element. -->
                    <StaticResource x:Key="Node.BackgroundBrush" ResourceKey="RuleNodeBg" />
                    <StaticResource x:Key="Node.ContentBrush" ResourceKey="RuleNodeBg" />
                    <StaticResource x:Key="Node.HeaderBrush" ResourceKey="RuleNodeBg" />
                    <StaticResource x:Key="Node.FooterBrush" ResourceKey="RuleNodeBg" />
                    <StaticResource x:Key="Node.ForegroundBrush" ResourceKey="RuleTextKey" />
                    <StaticResource x:Key="Node.HeaderForegroundBrush" ResourceKey="RuleTextKey" />
                    <StaticResource x:Key="Node.BorderBrush" ResourceKey="RuleNodeBorder" />
                    <StaticResource x:Key="ItemContainer.BorderBrush" ResourceKey="RuleNodeBorder" />
                    <StaticResource x:Key="ItemContainer.SelectedBrush" ResourceKey="RuleSelection" />
                    <StaticResource x:Key="ItemContainer.HighlightBrush" ResourceKey="RuleSelection" />
                    <StaticResource x:Key="NodifyEditor.BackgroundBrush" ResourceKey="RuleCanvasBg" />
                    <StaticResource x:Key="NodifyEditor.ForegroundBrush" ResourceKey="RuleTextKey" />
                    <StaticResource x:Key="NodifyEditor.FocusVisualBrush" ResourceKey="RuleSelection" />
                    <StaticResource x:Key="Connector.BorderBrush" ResourceKey="RuleWireWrite" />
                    <StaticResource x:Key="NodeInput.BorderBrush" ResourceKey="RuleWireWrite" />
                    <StaticResource x:Key="NodeOutput.BorderBrush" ResourceKey="RuleWireWrite" />
                    <StaticResource x:Key="NodeInput.ForegroundBrush" ResourceKey="RuleTextKey" />
                    <StaticResource x:Key="NodeOutput.ForegroundBrush" ResourceKey="RuleTextKey" />
                    <StaticResource x:Key="Connection.StrokeBrush" ResourceKey="RuleWireWrite" />
                    <StaticResource x:Key="PendingConnection.StrokeBrush" ResourceKey="RuleSelection" />
                    <StaticResource x:Key="PendingConnection.BackgroundBrush" ResourceKey="RuleNodeBg" />
                    <StaticResource x:Key="PendingConnection.BorderBrush" ResourceKey="RuleNodeBorder" />
                    <StaticResource x:Key="PendingConnection.ForegroundBrush" ResourceKey="RuleTextKey" />
                    <StaticResource x:Key="Minimap.BackgroundBrush" ResourceKey="RuleMinimapBg" />
                    <StaticResource x:Key="Minimap.ViewportStrokeBrush" ResourceKey="RuleSelection" />
                    <StaticResource x:Key="Minimap.ViewportBackgroundBrush" ResourceKey="RuleSelectionFill" />
                    <StaticResource x:Key="MinimapItem.BackgroundBrush" ResourceKey="RuleWireWrite" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="RuleKindEvent" Color="#DCDCAA" />
                    <SolidColorBrush x:Key="RuleKindEnrich" Color="#26A69A" />
                    <SolidColorBrush x:Key="RuleKindContext" Color="#569CD6" />
                    <SolidColorBrush x:Key="RuleKindStat" Color="#4FC1FF" />
                    <SolidColorBrush x:Key="RuleKindDerived" Color="#C586C0" />
                    <SolidColorBrush x:Key="RuleKindHighlight" Color="#FFA657" />
                    <SolidColorBrush x:Key="RuleKindDefine" Color="#7FD1A0" />
                    <SolidColorBrush x:Key="RuleKindSurface" Color="#9FB4BE" />
                    <SolidColorBrush x:Key="RuleKindDependency" Color="#B49AE8" />
                    <SolidColorBrush x:Key="RuleWireWrite" Color="#9090B0" />
                    <SolidColorBrush x:Key="RuleWireRead" Color="#7878A8" />
                    <SolidColorBrush x:Key="RuleWireGate" Color="#569CD6" />
                    <SolidColorBrush x:Key="RuleWireAnd" Color="#4CAF50" />
                    <SolidColorBrush x:Key="RuleWireOr" Color="#D98A3F" />
                    <SolidColorBrush x:Key="RuleCanvasBg" Color="#0C0C1A" />
                    <SolidColorBrush x:Key="RuleNodeBg" Color="#171726" />
                    <SolidColorBrush x:Key="RuleNodeBorder" Color="#3A3A66" />
                    <SolidColorBrush x:Key="RuleSelection" Color="#8A8AE0" />
                    <SolidColorBrush x:Key="RuleSelectionFill" Color="#268A8AE0" />
                    <SolidColorBrush x:Key="RuleCutLine" Color="#E53935" />
                    <SolidColorBrush x:Key="RuleMinimapBg" Color="#0E0E1E" />
                    <SolidColorBrush x:Key="RuleTextKey" Color="#A0A0D8" />
                    <SolidColorBrush x:Key="RuleWireHalo" Color="#99A0A0F0" />
                    <SolidColorBrush x:Key="RuleCheckGlyph" Color="#12121E" />
                    <SolidColorBrush x:Key="RuleDiagnosticBadgeText" Color="#0C0C1A" />
                    <SolidColorBrush x:Key="RuleDiagnosticWarning" Color="#E0A030" />
                    <SolidColorBrush x:Key="RuleLiveBadgeBg" Color="#24243C" />
                    <SolidColorBrush x:Key="RuleLiveStale" Color="#6E6E8C" />
                    <SolidColorBrush x:Key="RuleWireFlash" Color="#D9FFA657" />
                    <SolidColorBrush x:Key="RuleGroupFill" Color="#1A8A8AE0" />
                    <SolidColorBrush x:Key="RuleGroupHeaderBg" Color="#388A8AE0" />
                    <SolidColorBrush x:Key="RuleGroupBorder" Color="#4C4C84" />
                    <x:Double x:Key="RuleMinimapItemOpacity">1</x:Double>
                    <StaticResource x:Key="Node.BackgroundBrush" ResourceKey="RuleNodeBg" />
                    <StaticResource x:Key="Node.ContentBrush" ResourceKey="RuleNodeBg" />
                    <StaticResource x:Key="Node.HeaderBrush" ResourceKey="RuleNodeBg" />
                    <StaticResource x:Key="Node.FooterBrush" ResourceKey="RuleNodeBg" />
                    <StaticResource x:Key="Node.ForegroundBrush" ResourceKey="RuleTextKey" />
                    <StaticResource x:Key="Node.HeaderForegroundBrush" ResourceKey="RuleTextKey" />
                    <StaticResource x:Key="Node.BorderBrush" ResourceKey="RuleNodeBorder" />
                    <StaticResource x:Key="ItemContainer.BorderBrush" ResourceKey="RuleNodeBorder" />
                    <StaticResource x:Key="ItemContainer.SelectedBrush" ResourceKey="RuleSelection" />
                    <StaticResource x:Key="ItemContainer.HighlightBrush" ResourceKey="RuleSelection" />
                    <StaticResource x:Key="NodifyEditor.BackgroundBrush" ResourceKey="RuleCanvasBg" />
                    <StaticResource x:Key="NodifyEditor.ForegroundBrush" ResourceKey="RuleTextKey" />
                    <StaticResource x:Key="NodifyEditor.FocusVisualBrush" ResourceKey="RuleSelection" />
                    <StaticResource x:Key="Connector.BorderBrush" ResourceKey="RuleWireWrite" />
                    <StaticResource x:Key="NodeInput.BorderBrush" ResourceKey="RuleWireWrite" />
                    <StaticResource x:Key="NodeOutput.BorderBrush" ResourceKey="RuleWireWrite" />
                    <StaticResource x:Key="NodeInput.ForegroundBrush" ResourceKey="RuleTextKey" />
                    <StaticResource x:Key="NodeOutput.ForegroundBrush" ResourceKey="RuleTextKey" />
                    <StaticResource x:Key="Connection.StrokeBrush" ResourceKey="RuleWireWrite" />
                    <StaticResource x:Key="PendingConnection.StrokeBrush" ResourceKey="RuleSelection" />
                    <StaticResource x:Key="PendingConnection.BackgroundBrush" ResourceKey="RuleNodeBg" />
                    <StaticResource x:Key="PendingConnection.BorderBrush" ResourceKey="RuleNodeBorder" />
                    <StaticResource x:Key="PendingConnection.ForegroundBrush" ResourceKey="RuleTextKey" />
                    <StaticResource x:Key="Minimap.BackgroundBrush" ResourceKey="RuleMinimapBg" />
                    <StaticResource x:Key="Minimap.ViewportStrokeBrush" ResourceKey="RuleSelection" />
                    <StaticResource x:Key="Minimap.ViewportBackgroundBrush" ResourceKey="RuleSelectionFill" />
                    <StaticResource x:Key="MinimapItem.BackgroundBrush" ResourceKey="RuleWireWrite" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The editor reads these three themes by key; defining them here replaces Nodify's. -->
            <ControlTheme x:Key="NodifyEditor.SelectionRectangleTheme" TargetType="Rectangle">
                <Setter Property="Stroke" Value="{DynamicResource RuleSelection}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Fill" Value="{DynamicResource RuleSelectionFill}" />
            </ControlTheme>
            <ControlTheme x:Key="NodifyEditor.PushedAreaTheme" TargetType="Rectangle">
                <Setter Property="Stroke" Value="{DynamicResource RuleSelection}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Fill" Value="{DynamicResource RuleSelectionFill}" />
            </ControlTheme>
            <ControlTheme x:Key="NodifyEditor.CuttingLineTheme" TargetType="connections:CuttingLine">
                <Setter Property="Stroke" Value="{DynamicResource RuleCutLine}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeDashArray" Value="2,1" />
                <Setter Property="Fill" Value="{DynamicResource RuleCutLine}" />
            </ControlTheme>
            <!-- The header container keeps no padding of its own, so the kind stripe runs to the node's edge. -->
            <ControlTheme x:Key="RuleNodeHeaderTheme" TargetType="Border">
                <Setter Property="CornerRadius" Value="3 3 0 0" />
                <Setter Property="Padding" Value="0" />
            </ControlTheme>
            <ControlTheme x:Key="RuleMinimapViewportTheme" TargetType="Rectangle">
                <Setter Property="Stroke" Value="{DynamicResource RuleSelection}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="Fill" Value="{DynamicResource RuleSelectionFill}" />
            </ControlTheme>

            <!-- The toast: a card with a caution stripe, the text, and a close button; the control times itself out. -->
            <ControlTheme x:Key="{x:Type views:TransientToast}" TargetType="views:TransientToast">
                <Setter Property="MaxWidth" Value="360" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderAccent}" BorderThickness="1"
                                CornerRadius="4" Padding="0">
                            <Grid ColumnDefinitions="3,*,Auto,Auto">
                                <Border Grid.Column="0" Background="{DynamicResource AccentCaution}" CornerRadius="3 0 0 3" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Message}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextValue}" Margin="10 7" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Name="PART_Action" Classes="ghost" Content="{TemplateBinding ActionLabel}"
                                        IsVisible="{TemplateBinding HasAction}" FontSize="11" Padding="8 2" MinHeight="0" Margin="0 0 2 0"
                                        VerticalAlignment="Center" Foreground="{DynamicResource TextValue}" />
                                <Button Grid.Column="3" Name="PART_Close" Content="×" Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource TextMid}" Padding="6 2" Margin="0 2 4 0" VerticalAlignment="Top"
                                        ToolTip.Tip="Dismiss (Esc)" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- A panel toggle in the strip: a ghost button that fills when its panel shows. -->
    <Style Selector="ToggleButton.panel">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8 3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
    </Style>
    <Style Selector="ToggleButton.panel:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PanelHeaderHover}" />
    </Style>
    <Style Selector="ToggleButton.panel:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PanelHeaderHoverDeep}" />
        <Setter Property="Foreground" Value="{DynamicResource TextValue}" />
    </Style>

    <!-- A gallery group's heading: a full-width toggle that folds its items. -->
    <Style Selector="ToggleButton.expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4 3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ToggleButton.expander:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PanelHeaderHover}" />
    </Style>
    <Style Selector="ToggleButton.expander:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- A checkbox on a node face: checked, its box and tick are the canvas's selection tokens rather than
         Fluent's accent. Styles outrank the control theme, so the hover and pressed states follow. -->
    <Style Selector="CheckBox.face:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource RuleSelection}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RuleSelection}" />
    </Style>
    <Style Selector="CheckBox.face:checked /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource RuleCheckGlyph}" />
    </Style>
    <Style Selector="CheckBox.face:unchecked /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource RuleWireWrite}" />
    </Style>

    <!-- The live value badge's text: the value colour while current, the stale grey once the text moved on. -->
    <Style Selector="TextBlock.liveBadge">
        <Setter Property="Foreground" Value="{DynamicResource TextValue}" />
    </Style>
    <Style Selector="TextBlock.liveBadge.stale">
        <Setter Property="Foreground" Value="{DynamicResource RuleLiveStale}" />
    </Style>

    <!-- The pinned viewer under a node: the whole panel dims when the run is stale; in its breakdown the
         selected instance's row is the selection token and the others the read-wire grey. -->
    <Style Selector="Border.liveViewer">
        <Setter Property="Background" Value="{DynamicResource RuleNodeBg}" />
    </Style>
    <Style Selector="Border.liveViewer.stale">
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.viewerBar">
        <Setter Property="Background" Value="{DynamicResource RuleWireRead}" />
    </Style>
    <Style Selector="Border.viewerBar.selected">
        <Setter Property="Background" Value="{DynamicResource RuleSelection}" />
    </Style>
    <Style Selector="TextBlock.viewerName">
        <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
    </Style>
    <Style Selector="TextBlock.viewerName.selected">
        <Setter Property="Foreground" Value="{DynamicResource TextValue}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A card centred over the canvas for a state with nothing to draw. -->
    <Style Selector="Border.emptyCard">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="24 20" />
    </Style>

    <!-- The editor. -->
    <Style Selector="nodify|NodifyEditor">
        <Setter Property="Background" Value="{DynamicResource RuleCanvasBg}" />
        <Setter Property="Foreground" Value="{DynamicResource RuleTextKey}" />
    </Style>

    <!-- The node frame is the container's border: 1px at rest, a 2px ring when selected or hovered by a
         pending wire, grown outward so the face does not shift. -->
    <Style Selector="nodify|ItemContainer">
        <Setter Property="BorderBrush" Value="{DynamicResource RuleNodeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SelectedBrush" Value="{DynamicResource RuleSelection}" />
        <Setter Property="HighlightBrush" Value="{DynamicResource RuleSelection}" />
        <Setter Property="SelectedBorderThickness" Value="2" />
    </Style>
    <Style Selector="nodify|ItemContainer /template/ Rectangle#PART_KeyboardFocusVisual">
        <Setter Property="Stroke" Value="{DynamicResource RuleSelection}" />
    </Style>

    <Style Selector="nodes|Node">
        <Setter Property="Background" Value="{DynamicResource RuleNodeBg}" />
        <Setter Property="Foreground" Value="{DynamicResource RuleTextKey}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HeaderContainerStyle" Value="{StaticResource RuleNodeHeaderTheme}" />
    </Style>

    <!-- A frame around nodes: translucent, so what it groups stays readable through it. -->
    <Style Selector="nodes|GroupingNode">
        <Setter Property="Background" Value="{DynamicResource RuleGroupFill}" />
        <Setter Property="HeaderBrush" Value="{DynamicResource RuleGroupHeaderBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RuleGroupBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource RuleTextKey}" />
    </Style>

    <!-- Ports: a ring at rest, filled while wired. No strip behind them; the face is the background. -->
    <Style Selector="nodes|NodeInput, nodes|NodeOutput">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource RuleTextKey}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RuleWireWrite}" />
    </Style>
    <Style Selector="connections|Connector">
        <Setter Property="BorderBrush" Value="{DynamicResource RuleWireWrite}" />
    </Style>

    <!-- Wires by meaning: a write is solid; a read is a short dash; a gate holds rather than fires, so a
         long dash; a logic input carries its connective's colour. Fill paints the arrow head. -->
    <Style Selector="connections|Connection">
        <Setter Property="Stroke" Value="{DynamicResource RuleWireWrite}" />
        <Setter Property="Fill" Value="{DynamicResource RuleWireWrite}" />
    </Style>
    <Style Selector="connections|Connection.read">
        <Setter Property="Stroke" Value="{DynamicResource RuleWireRead}" />
        <Setter Property="Fill" Value="{DynamicResource RuleWireRead}" />
        <Setter Property="StrokeDashArray" Value="4,3" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="connections|Connection.gate">
        <Setter Property="Stroke" Value="{DynamicResource RuleWireGate}" />
        <Setter Property="Fill" Value="{DynamicResource RuleWireGate}" />
        <Setter Property="StrokeDashArray" Value="8,4" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>

    <!-- Wires are selectable: a halo under the hovered wire says it can be picked, a wider one marks the
         selection. RuleWireHalo carries its own alpha, so the stroke on top stays readable. -->
    <Style Selector="connections|Connection:pointerover">
        <Setter Property="OutlineThickness" Value="3" />
        <Setter Property="OutlineBrush" Value="{DynamicResource RuleWireHalo}" />
    </Style>
    <Style Selector="connections|Connection[(connections|BaseConnection.IsSelected)=true]">
        <Setter Property="OutlineThickness" Value="5" />
        <Setter Property="OutlineBrush" Value="{DynamicResource RuleWireHalo}" />
    </Style>

    <!-- A wire that fired at the tick a step landed on: the one transient paint, cleared after 300 ms. After
         the selection style, so a flashing selected wire shows the flash. -->
    <Style Selector="connections|Connection.flash">
        <Setter Property="OutlineThickness" Value="7" />
        <Setter Property="OutlineBrush" Value="{DynamicResource RuleWireFlash}" />
    </Style>

    <Style Selector="connections|Connection.and">
        <Setter Property="Stroke" Value="{DynamicResource RuleWireAnd}" />
        <Setter Property="Fill" Value="{DynamicResource RuleWireAnd}" />
    </Style>
    <Style Selector="connections|Connection.or">
        <Setter Property="Stroke" Value="{DynamicResource RuleWireOr}" />
        <Setter Property="Fill" Value="{DynamicResource RuleWireOr}" />
    </Style>

    <Style Selector="connections|PendingConnection">
        <Setter Property="Stroke" Value="{DynamicResource RuleSelection}" />
        <Setter Property="Background" Value="{DynamicResource RuleNodeBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RuleNodeBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource RuleTextKey}" />
    </Style>

    <Style Selector="nodify|Minimap">
        <Setter Property="Background" Value="{DynamicResource RuleMinimapBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RuleNodeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ViewportStyle" Value="{StaticResource RuleMinimapViewportTheme}" />
    </Style>
    <Style Selector="nodify|MinimapItem">
        <Setter Property="Background" Value="{DynamicResource RuleWireWrite}" />
        <Setter Property="Opacity" Value="{DynamicResource RuleMinimapItemOpacity}" />
    </Style>
</Styles>
