<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dash="using:DemoViewer.NET.Extensions.StratBook.ViewModels.ScoutingDashboard"
             xmlns:vm="using:DemoViewer.NET.Extensions.StratBook.ViewModels.ScoutingReport"
             xmlns:layers="using:DemoViewer.NET.Extensions.StratBook.ViewModels.ScoutingReport.Layers"
             xmlns:sr="using:DemoViewer.NET.Extensions.StratBook.Views.ScoutingReport"
             xmlns:local="using:DemoViewer.NET.Extensions.StratBook.Views.ScoutingDashboard"
             x:Class="DemoViewer.NET.Extensions.StratBook.Views.ScoutingDashboard.ScoutingDashboardTabView"
             x:DataType="dash:ScoutingDashboardTabViewModel">

    <!--
      THE SCOUTING REPORT AS A DASHBOARD: the same report as the Layers tab, laid out as cards. Top to bottom: the
      header (team, record, ranks, export, the stat tiles and the sample by date), the roster, the map tabs with
      the side, the one-pager, the map's record, the cards of the side in view, the AWP card, the map-wide cards,
      and the collapsed Period Diff, veto history and long form.

      Every card leads with its finding and a star; every number with rounds behind it is a dotted-underline
      button that opens them in Review. Colour is {DynamicResource} tokens only, so both themes read.
    -->

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14 12" />
        </Style>
        <Style Selector="TextBlock.h">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
        </Style>
        <Style Selector="TextBlock.mid">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
        </Style>
        <Style Selector="TextBlock.col-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
        </Style>
        <Style Selector="TextBlock.val">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextValue}" />
        </Style>
        <Style Selector="TextBlock.tile">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextValue}" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
        </Style>
        <Style Selector="Button.ghost:disabled">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.ghost:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- A number that opens its rounds: plain text with a dotted underline, a button underneath. -->
        <Style Selector="Button.num">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2 0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextValue}" />
        </Style>
        <Style Selector="Button.num:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelHeaderHover}" />
        </Style>
        <Style Selector="Button.num:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.num:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextValue}" />
        </Style>
        <Style Selector="Button.num TextBlock">
            <Setter Property="TextDecorations">
                <TextDecorationCollection>
                    <TextDecoration Location="Underline" StrokeThickness="1" StrokeThicknessUnit="Pixel"
                                    StrokeDashArray="1,2" StrokeOffset="2" StrokeOffsetUnit="Pixel" />
                </TextDecorationCollection>
            </Setter>
        </Style>
        <!-- A link out of the app: plain words with a solid underline, a button underneath. -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2 0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelHeaderHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
        </Style>
        <Style Selector="Button.link:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.link TextBlock">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <!-- Map tabs and the side tabs: the selected one underlined. -->
        <Style Selector="Button.maptab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0 0 0 2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12 10" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.maptab.on">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource TextCardHeader}" />
        </Style>
        <Style Selector="Button.maptab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelHeaderHover}" />
        </Style>
        <Style Selector="Button.maptab:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
        </Style>
        <Style Selector="RadioButton.seg">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Box" Background="{TemplateBinding Background}" Padding="20 8"
                            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                        <ContentPresenter Content="{TemplateBinding Content}" FontWeight="Bold" FontSize="13"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="RadioButton.seg.ct:checked">
            <Setter Property="Background" Value="{DynamicResource Pb2dTeamCt}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        </Style>
        <Style Selector="RadioButton.seg.t:checked">
            <Setter Property="Background" Value="{DynamicResource Pb2dTeamT}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        </Style>
        <Style Selector="RadioButton.seg.pill /template/ Border#PART_Box">
            <Setter Property="Padding" Value="10 3" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="RadioButton.seg.pill">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="RadioButton.seg.pill:checked">
            <Setter Property="Background" Value="{DynamicResource FrameRowSelectedBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
        </Style>
        <Style Selector="RadioButton.seg.pill:checked /template/ Border#PART_Box">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
        </Style>
        <Style Selector="RadioButton.seg:focus-visible /template/ Border#PART_Box">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
        </Style>
        <Style Selector="Path.star">
            <Setter Property="Stroke" Value="{DynamicResource TextMid}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style Selector="Path.star.on">
            <Setter Property="Stroke" Value="{DynamicResource AccentAmber}" />
            <Setter Property="Fill" Value="{DynamicResource AccentAmber}" />
        </Style>
        <Style Selector="Path.chevron">
            <Setter Property="Stroke" Value="{DynamicResource TextMid}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Data" Value="M9,6 L15,12 L9,18" />
        </Style>
        <Style Selector="Path.chevron.open">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="Border.notice">
            <Setter Property="Background" Value="{DynamicResource HexBannerBg}" />
            <Setter Property="Padding" Value="12 8" />
        </Style>
        <!-- The shared primary button sets a monospace face; this page's labels are words, not code. -->
        <Style Selector="Button.primary">
            <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
        </Style>
        <Style Selector="Border.skel">
            <Setter Property="Background" Value="{DynamicResource StatBarTrack}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Height" Value="9" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.empty">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20 18" />
        </Style>
        <Style Selector="Border.empty TextBlock.lead">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.empty TextBlock.body">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- A stat tile in the header: a label over its number. -->
        <Style Selector="Border.tile">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12 8" />
            <Setter Property="Margin" Value="0 0 10 8" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
        <!-- Each card in the grid carries its own span. -->
        <Style Selector="ItemsControl.cards > ContentPresenter" x:DataType="dash:ScoutingDashboardCardViewModel">
            <Setter Property="local:ScoutingCardGrid.IsWide" Value="{Binding IsWide}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <StreamGeometry x:Key="StarGeometry">M12,3 L14.7,8.6 L20.8,9.5 L16.4,13.8 L17.4,19.9 L12,17 L6.6,19.9 L7.6,13.8 L3.2,9.5 L9.3,8.6 Z</StreamGeometry>
        <StreamGeometry x:Key="PlayGeometry">M7,4 L7,20 L20,12 Z</StreamGeometry>

        <DataTemplate x:Key="RankBox" x:DataType="vm:RankFieldViewModel">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="mid" Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBlock Classes="mid" Text="#" VerticalAlignment="Center" />
                <TextBox Text="{Binding Text, Mode=TwoWay}" Width="52" MinHeight="0" Padding="5 2" FontSize="12"
                         PlaceholderText="—" LostFocus="OnRankLostFocus"
                         AutomationProperties.Name="{Binding AutomationName}"
                         ToolTip.Tip="Type a rank and press Enter. Empty clears it; Escape undoes. Earlier ranks stay as history.">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                        <KeyBinding Gesture="Escape" Command="{Binding RevertCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextBright}" Text="{Binding SetLine}"
                           VerticalAlignment="Center" />
                <TextBlock FontSize="11" Foreground="{DynamicResource StatNegative}" Text="{Binding Error}"
                           IsVisible="{Binding HasError}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- One card line: a read sentence or a row; its number opens its rounds; the star files it. -->
        <DataTemplate x:Key="CardRow" x:DataType="layers:ScoutingInspectorRowViewModel">
            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1" Padding="0 5">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsRead}">
                            <Border Width="16" Height="16" CornerRadius="8" IsVisible="{Binding HasBadge}"
                                    Background="{DynamicResource TextValue}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource CardBg}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Width="10" Height="10" CornerRadius="2" IsVisible="{Binding HasSwatch}"
                                    VerticalAlignment="Center"
                                    Background="{Binding Color, Converter={x:Static sr:ScoutingColorBrush.Instance}}" />
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextValue}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextBright}" IsVisible="{Binding IsRead}" />
                        <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentCaution}" IsVisible="{Binding HasNote}" />
                        <Border Width="{x:Static layers:ScoutingInspectorRowViewModel.BarMaxWidth}" Height="6"
                                CornerRadius="3" HorizontalAlignment="Left" IsVisible="{Binding HasBar}"
                                Background="{DynamicResource StatBarTrack}">
                            <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="3"
                                    Background="{Binding Color, Converter={x:Static sr:ScoutingColorBrush.Instance}}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <Button Classes="num" IsVisible="{Binding CanOpen}" Command="{Binding OpenCommand}"
                                ToolTip.Tip="{Binding OpenToolTip}"
                                AutomationProperties.Name="{Binding OpenToolTip}">
                            <TextBlock Text="{Binding Value}" FontSize="12" />
                        </Button>
                        <TextBlock Text="{Binding Value}" FontSize="12" IsVisible="{Binding ShowsPlainValue}"
                                   Foreground="{DynamicResource TextValue}" />
                        <Button Classes="ghost" Padding="6 2" IsVisible="{Binding CanPlay}"
                                Command="{Binding PlayCommand}" ToolTip.Tip="Play in 2D"
                                AutomationProperties.Name="Play in 2D">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Path Data="{StaticResource PlayGeometry}" Width="9" Height="9" Stretch="Uniform"
                                      Fill="{DynamicResource TextValue}" />
                                <TextBlock Text="2D" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="ghost" Padding="3" VerticalAlignment="Top"
                            Command="{Binding ToggleStarCommand}" IsVisible="{Binding !IsPlaceholder}"
                            ToolTip.Tip="{Binding StarLabel}" AutomationProperties.Name="{Binding StarLabel}">
                        <Path Classes="star" Classes.on="{Binding IsStarred}" Data="{StaticResource StarGeometry}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A layer's strip chart, one template per chart type (the Layers tab's strip minis, drawn larger). -->
        <DataTemplate x:Key="Chart" x:DataType="layers:ScoutingMiniChart">
            <StackPanel Spacing="4">
                <ContentControl Content="{Binding}">
                    <ContentControl.DataTemplates>
                        <DataTemplate x:DataType="layers:ScoutingStackChart">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="layers:ScoutingStackRow">
                                        <Grid ColumnDefinitions="140,*,64" Margin="0 0 0 6"
                                              ToolTip.Tip="{Binding Text}" AutomationProperties.Name="{Binding Text}">
                                            <TextBlock Grid.Column="0" FontSize="12" Text="{Binding Label}"
                                                       Foreground="{DynamicResource TextBright}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <sr:ScoutingMiniGraphic Grid.Column="1" Value="{Binding}" Margin="6 0" Height="20" />
                                            <TextBlock Grid.Column="2" FontSize="12" Text="{Binding Trailing}"
                                                       Foreground="{DynamicResource TextValue}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                        <DataTemplate x:DataType="layers:ScoutingStripChart">
                            <ItemsControl ItemsSource="{Binding Lanes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="layers:ScoutingStripLane">
                                        <Grid ColumnDefinitions="28,*" Margin="0 0 0 6"
                                              ToolTip.Tip="{Binding Text}" AutomationProperties.Name="{Binding Text}">
                                            <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold" Text="{Binding Label}"
                                                       Foreground="{DynamicResource TextBright}" VerticalAlignment="Center" />
                                            <sr:ScoutingMiniGraphic Grid.Column="1" Value="{Binding}" Height="24" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                        <DataTemplate x:DataType="layers:ScoutingDumbbellChart">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="layers:ScoutingDumbbell">
                                        <Grid ColumnDefinitions="30,*,84" Margin="0 0 0 6">
                                            <TextBlock Grid.Column="0" FontSize="12" FontWeight="Bold" Text="{Binding Label}"
                                                       Foreground="{DynamicResource TextValue}" VerticalAlignment="Center" />
                                            <sr:ScoutingMiniGraphic Grid.Column="1" Value="{Binding}" Margin="0 0 8 0" Height="20" />
                                            <TextBlock Grid.Column="2" FontSize="12" Text="{Binding Value}"
                                                       Foreground="{DynamicResource TextBright}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                        <DataTemplate x:DataType="layers:ScoutingTableChart">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,56,56">
                                    <TextBlock Grid.Column="0" Classes="col-label" Text="Score" />
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Text="{Binding First}"
                                               Foreground="{DynamicResource Pb2dTeamCt}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Text="{Binding Second}"
                                               Foreground="{DynamicResource Pb2dTeamT}" HorizontalAlignment="Right" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="layers:ScoutingTableRow">
                                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 1 0 0" Padding="0 4">
                                                <Grid ColumnDefinitions="*,56,56">
                                                    <TextBlock Grid.Column="0" FontSize="12" Text="{Binding Label}"
                                                               Foreground="{DynamicResource TextBright}" />
                                                    <TextBlock Grid.Column="1" FontSize="12" Text="{Binding First}"
                                                               Foreground="{DynamicResource TextValue}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="2" FontSize="12" Text="{Binding Second}"
                                                               Foreground="{DynamicResource TextValue}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextBright}"
                           Text="{Binding Caption}" />
            </StackPanel>
        </DataTemplate>

        <!-- A card's head: title, build status, what it waits on, the finding it leads with, the AWP windows. -->
        <DataTemplate x:Key="CardHead" x:DataType="dash:ScoutingDashboardCardViewModel">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBright}" TextWrapping="Wrap" />
                        <Border Grid.Column="1" BorderBrush="{DynamicResource AccentCaution}" BorderThickness="1"
                                CornerRadius="4" Padding="5 1" VerticalAlignment="Center"
                                IsVisible="{Binding $parent[UserControl].((dash:ScoutingDashboardTabViewModel)DataContext).Report.ShowBuildStatus, FallbackValue=False}">
                            <TextBlock Text="{Binding BuildCode}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentCaution}" />
                        </Border>
                    </Grid>
                    <!-- Still building: skeleton where the finding and the rows will land. -->
                    <StackPanel Spacing="8" Margin="0 4 0 4" IsVisible="{Binding IsBuilding}">
                        <Border Classes="skel" Width="280" Height="11" />
                        <Border Classes="skel" Width="200" Height="11" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0 6 0 0">
                            <Border Classes="skel" Width="150" />
                            <Border Grid.Column="1" Classes="skel" Width="54" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Classes="skel" Width="120" />
                            <Border Grid.Column="1" Classes="skel" Width="54" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBright}" IsVisible="{Binding HasStatusMessage}" />
                    <ItemsControl ItemsSource="{Binding Reads}" ItemTemplate="{StaticResource CardRow}" />
                    <TextBlock Text="{Binding NoFindingLine}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBright}" IsVisible="{Binding HasNoFinding}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasWindows}">
                        <TextBlock Classes="mid" Text="Show movement to" VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding Windows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="layers:ScoutingWindowPillViewModel">
                                    <RadioButton Classes="seg pill" GroupName="dashboard-awp-window" Content="{Binding Label}"
                                                 IsChecked="{Binding IsOn, Mode=OneWay}" Command="{Binding PickCommand}"
                                                 AutomationProperties.Name="{Binding AccessibleName}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
        </DataTemplate>

        <!-- The layer's marks on the radar: drawn once per build, off the UI thread. -->
        <DataTemplate x:Key="CardMap" x:DataType="dash:ScoutingDashboardCardViewModel">
            <Border CornerRadius="6" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                    Background="{DynamicResource PanelBg}" ClipToBounds="True" MinHeight="80" MinWidth="320"
                    HorizontalAlignment="Center" Margin="0 4 0 2">
                <Panel>
                    <Image Source="{Binding MapImage}" Stretch="Uniform"
                           IsVisible="{Binding HasMapImage}" HorizontalAlignment="Center"
                           AutomationProperties.Name="{Binding MapTag}" />
                    <TextBlock Text="{Binding MapNote}" FontSize="12" TextWrapping="Wrap" Margin="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextBright}" IsVisible="{Binding HasMapNote}" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="6 2"
                            CornerRadius="4" Background="{DynamicResource CardBg}" IsVisible="{Binding HasMapImage}">
                        <TextBlock Text="{Binding MapTag}" FontSize="11" Foreground="{DynamicResource TextBright}" />
                    </Border>
                </Panel>
            </Border>
        </DataTemplate>

        <!-- The card's chart and its sections; a wide card lays its sections out in columns. -->
        <DataTemplate x:Key="CardBody" x:DataType="dash:ScoutingDashboardCardViewModel">
            <StackPanel Spacing="6">
                <ContentControl Content="{Binding Chart}" ContentTemplate="{StaticResource Chart}"
                                IsVisible="{Binding HasChart}" Margin="0 4 0 2" />
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:ScoutingCardGrid MinColumnWidth="360" Spacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="layers:ScoutingInspectorSectionViewModel">
                            <StackPanel Margin="0 4 0 0">
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextCardHeader}" Margin="0 0 0 2"
                                           IsVisible="{Binding HasTitle}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource CardRow}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- One card: head, picture, chart and rows, top to bottom. -->
        <DataTemplate x:Key="Card" x:DataType="dash:ScoutingDashboardCardViewModel">
            <Border Classes="card" AutomationProperties.Name="{Binding Title}">
                <StackPanel Spacing="6">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardHead}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardMap}" MaxHeight="380"
                                    IsVisible="{Binding ShowsMap}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardBody}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A full-width card with a picture (AWP): the picture on the left, its rows beside it. -->
        <DataTemplate x:Key="WideMapCard" x:DataType="dash:ScoutingDashboardCardViewModel">
            <Border Classes="card" AutomationProperties.Name="{Binding Title}">
                <StackPanel Spacing="6">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CardHead}" />
                    <Grid ColumnDefinitions="3*,20,2*">
                        <ContentControl Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource CardMap}"
                                        MaxHeight="620" VerticalAlignment="Top" />
                        <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource CardBody}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="CardGrid">
            <local:ScoutingCardGrid MinColumnWidth="400" Spacing="14" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="MapWideGrid">
            <local:ScoutingCardGrid MinColumnWidth="560" Spacing="14" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource ShellBg}">
        <StackPanel Margin="16" Spacing="14">
            <!-- Feedback: both layouts ship this release; one quiet line asks which reads better. -->
            <WrapPanel Orientation="Horizontal" Margin="2 0">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextBright}" VerticalAlignment="Center"
                           Text="Two layouts this release. Tell us which you prefer" Margin="0 0 6 0" />
                <Button Classes="link" Command="{Binding Report.GiveFeedbackCommand}"
                        AutomationProperties.Name="Give feedback on the Scouting Report layouts"
                        ToolTip.Tip="{x:Static vm:ScoutingReportTabViewModel.FeedbackUrl}">
                    <TextBlock Text="Give feedback" />
                </Button>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextBright}" VerticalAlignment="Center"
                           Text="· full long-form editing (rewrite, reset, dismiss) is in the Layers tab"
                           Margin="6 0 0 0" />
            </WrapPanel>
            <!-- Empty: no team found yet. -->
            <Border Classes="empty" IsVisible="{Binding !Report.HasTeams}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="lead" Text="No teams to scout yet" />
                    <TextBlock Classes="body"
                               Text="A team appears once the same players are seen together in two demos. Add the opponent's demos to the library; when they are indexed the team shows up here, and in Library › Teams, where you can name it." />
                </StackPanel>
            </Border>

            <!-- Header: who, the record, the ranks, the export; the stat tiles; the sample by date. -->
            <Border Classes="panel" IsVisible="{Binding Report.HasTeams}">
                <StackPanel Margin="14 12" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding Report.Teams}" SelectedItem="{Binding Report.SelectedTeam}"
                                      PlaceholderText="Select a team" FontSize="18" FontWeight="Bold"
                                      MinWidth="200" Margin="0 0 16 4" AutomationProperties.Name="Team" />
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 20 4"
                                        VerticalAlignment="Center" IsVisible="{Binding Report.HasSelection}">
                                <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource StatPositive}"
                                           Text="{Binding Report.Wins, StringFormat='W {0}'}" />
                                <TextBlock Classes="mid" Text="/" />
                                <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource StatNegative}"
                                           Text="{Binding Report.Losses, StringFormat='L {0}'}" />
                                <TextBlock Classes="mid" Text="{Binding Report.RecordLine, StringFormat='· {0}'}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0 0 20 4"
                                        VerticalAlignment="Center" IsVisible="{Binding Report.HasSelection}">
                                <ContentControl Content="{Binding Report.VrsRank}" ContentTemplate="{StaticResource RankBox}" />
                                <ContentControl Content="{Binding Report.HltvRank}" ContentTemplate="{StaticResource RankBox}" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource StatNegative}"
                                           Text="{Binding Report.RanksProblem}" IsVisible="{Binding Report.HasRanksProblem}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top"
                                    IsVisible="{Binding Report.HasSelection}">
                            <CheckBox Content="Build status" FontSize="12" IsChecked="{Binding Report.ShowBuildStatus}"
                                      ToolTip.Tip="Show each card's data status (E exists, D derivable, R app work, K engine work)" />
                            <ComboBox FontSize="12" ItemsSource="{x:Static vm:ScoutingReportEditorViewModel.FormOptions}"
                                      SelectedItem="{Binding Report.Editor.SelectedFormOption}"
                                      AutomationProperties.Name="Export form"
                                      ToolTip.Tip="One-pager: the starred lines. Long form: every line not dismissed." />
                            <ComboBox FontSize="12" ItemsSource="{x:Static vm:ScoutingReportEditorViewModel.FormatOptions}"
                                      SelectedItem="{Binding Report.Editor.SelectedFormatOption}"
                                      AutomationProperties.Name="Export format" IsVisible="{Binding !Report.IsBrowser}" />
                            <Button Classes="primary" FontSize="12" Padding="12 6"
                                    Content="{Binding Report.Editor.ExportLabel}"
                                    Command="{Binding Report.Editor.ExportCommand}" IsVisible="{Binding !Report.IsBrowser}" />
                            <Button Content="Copy markdown" Classes="ghost" FontSize="12" Padding="10 6"
                                    Click="OnCopyMarkdownClick" />
                        </StackPanel>
                    </Grid>

                    <!-- The stat tiles. -->
                    <WrapPanel Orientation="Horizontal" IsVisible="{Binding Report.HasSelection}">
                        <Border Classes="tile">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="mid" Text="Deciders" />
                                <TextBlock Classes="tile" Text="{Binding DecidersValue}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="tile">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="mid" Text="Pistols, every map" />
                                <TextBlock Classes="tile" Text="{Binding PistolsLine}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="tile">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="mid" Text="{Binding FormTitle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="tile" Text="{Binding FormValue}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextBright}" VerticalAlignment="Center"
                                               Text="{Binding FormNote}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Classes="tile">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="mid" Text="Head to head" />
                                <TextBlock Classes="tile" Text="{Binding HeadToHeadValue}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- The sample by date. -->
                    <WrapPanel Orientation="Horizontal" IsVisible="{Binding Report.HasSelection}">
                        <Border Width="{x:Static vm:TimelineDotViewModel.Width}" Height="24" Margin="0 0 14 4"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="The team's demos by date; filled is won, the map in view is bright">
                            <ItemsControl ItemsSource="{Binding Report.Timeline}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Styles>
                                    <Style Selector="ContentPresenter" x:DataType="vm:TimelineDotViewModel">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TimelineDotViewModel">
                                        <Panel Width="{Binding Size}" Height="{Binding Size}" Opacity="{Binding Opacity}" ToolTip.Tip="{Binding ToolTip}">
                                            <Ellipse Fill="{DynamicResource TextValue}" IsVisible="{Binding Won}" />
                                            <Ellipse Stroke="{DynamicResource TextValue}" StrokeThickness="1.5"
                                                     IsVisible="{Binding !Won}" />
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0 0 0 4">
                            <TextBlock Classes="mid" Text="{Binding Report.DemosLine}" />
                            <TextBlock Classes="mid" Text="{Binding Report.OpponentMixLine}" />
                            <TextBlock FontSize="11" Text="{Binding Report.TimelineCaption}"
                                       Foreground="{DynamicResource TextBright}" />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Spacing="2" IsVisible="{Binding Report.HasSelection}">
                        <TextBlock Classes="mid" Text="{Binding Report.Editor.ExportUnavailableNote}"
                                   IsVisible="{Binding Report.Editor.HasExportUnavailableNote}" />
                        <TextBlock Classes="mid" Text="{Binding Report.Editor.ExportLine}" TextWrapping="Wrap"
                                   IsVisible="{Binding Report.Editor.ExportLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Empty: teams exist, none picked. -->
            <Border Classes="empty" IsVisible="{Binding Report.IsAwaitingTeam}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="lead" Text="Pick a team to open its dashboard" />
                    <TextBlock Classes="body"
                               Text="Choose the opponent in the box above. The dashboard shows its record and roster, then one map and one side at a time as cards: each leads with a finding you can star for the one-pager, and its numbers open their rounds in Review." />
                </StackPanel>
            </Border>

            <!-- Empty: the team is open but has no map. -->
            <Border Classes="empty" IsVisible="{Binding Report.HasSelectionWithoutMaps}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="lead" Text="{Binding Report.TeamName, StringFormat='No demos for {0} yet'}" />
                    <TextBlock Classes="body"
                               Text="No indexed demo has this team on a side. Add its demos to the library and let them index; if it played under another lineup, merge the two in Library › Teams." />
                </StackPanel>
            </Border>

            <!-- Roster: the five, their roles, numbers and spots on the map in view. -->
            <Border Classes="panel" Padding="14 10" IsVisible="{Binding Report.HasMaps}">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="h" Text="{Binding Report.PlayersTitle, StringFormat='Roster · {0}'}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextBright}" VerticalAlignment="Center"
                                   Text="roles are suggested from the demos; the reason is under each" />
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentCaution}" TextWrapping="Wrap"
                               Text="{Binding Report.PlayersStatusLine}" IsVisible="{Binding Report.HasPlayersStatus}" />
                    <Grid ColumnDefinitions="20,1.3*,1.8*,0.7*,0.7*,0.7*,0.9*,2.2*" Margin="0 6 0 2">
                        <TextBlock Grid.Column="1" Classes="col-label" Text="Player" />
                        <TextBlock Grid.Column="2" Classes="col-label" Text="Role" />
                        <TextBlock Grid.Column="3" Classes="col-label" Text="Rating" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Classes="col-label" Text="K/D" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Classes="col-label" Text="ADR" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Classes="col-label" Text="Opening" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="7" Classes="col-label" Margin="20 0 0 0"
                                   Text="{Binding Report.SelectedMap.MapLabel, StringFormat='On {0}', FallbackValue='On the map'}" />
                    </Grid>
                    <TextBlock Classes="mid" TextWrapping="Wrap" IsVisible="{Binding !Report.HasPlayers}"
                               Text="No current roster for this team yet. Team Identity names the five once they have played together in two demos; Library › Teams shows what it has." />
                    <ItemsControl ItemsSource="{Binding Report.Players}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlayerRowViewModel">
                                <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 1 0 0" Padding="0 5">
                                    <Grid ColumnDefinitions="20,1.3*,1.8*,0.7*,0.7*,0.7*,0.9*,2.2*">
                                        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top" Margin="0 3 0 0"
                                                 Fill="{Binding Color, Converter={x:Static sr:ScoutingColorBrush.Instance}}" />
                                        <StackPanel Grid.Column="1">
                                            <Button Classes="num" HorizontalAlignment="Left" Padding="0"
                                                    Command="{Binding OpenOverviewCommand}" IsEnabled="{Binding OpenOverviewCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    ToolTip.Tip="{Binding OverviewToolTip}" AutomationProperties.Name="{Binding OverviewToolTip}">
                                                <TextBlock Classes="val" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </Button>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextBright}" Text="{Binding Appearances}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0 0 6 0">
                                            <TextBlock Classes="val" Text="{Binding Role}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextBright}" Text="{Binding RoleNote}"
                                                       IsVisible="{Binding HasRoleNote}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Classes="val" Text="{Binding Rating.Label}" HorizontalAlignment="Right" ToolTip.Tip="{Binding Rating.ToolTip}" />
                                        <TextBlock Grid.Column="4" Classes="val" Text="{Binding KillDeath.Label}" HorizontalAlignment="Right" ToolTip.Tip="{Binding KillDeath.ToolTip}" />
                                        <TextBlock Grid.Column="5" Classes="val" Text="{Binding Adr.Label}" HorizontalAlignment="Right" ToolTip.Tip="{Binding Adr.ToolTip}" />
                                        <TextBlock Grid.Column="6" Classes="val" Text="{Binding Opening.Label}" HorizontalAlignment="Right" ToolTip.Tip="{Binding Opening.ToolTip}" />
                                        <TextBlock Grid.Column="7" Classes="mid" Margin="20 0 0 0" TextWrapping="Wrap" ToolTip.Tip="{Binding CtSpotNote}">
                                            <Run Text="CT" FontWeight="SemiBold" Foreground="{DynamicResource Pb2dTeamCt}" />
                                            <Run Text="{Binding CtSpot}" />
                                            <Run Text=" · " />
                                            <Run Text="T" FontWeight="SemiBold" Foreground="{DynamicResource Pb2dTeamT}" />
                                            <Run Text="{Binding TRole}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextBright}" TextWrapping="Wrap" Margin="0 4 0 0"
                               Text="{Binding StandInNote}" />
                </StackPanel>
            </Border>

            <!-- Map and side: the map tabs, the side, the buy and the scope; then the notices. -->
            <Border Classes="panel" IsVisible="{Binding Report.HasMaps}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="6 0 14 0">
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding Report.Maps}" ItemsPanel="{StaticResource WrapItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MapPoolRowViewModel">
                                    <Button Classes="maptab" Classes.on="{Binding IsSelected}"
                                            Command="{Binding $parent[UserControl].((dash:ScoutingDashboardTabViewModel)DataContext).Report.SelectMapCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding MapLabel}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding MapLabel}" FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="{Binding TabDetail}" FontSize="11"
                                                       Foreground="{DynamicResource TextBright}" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Classes="seg ct" Content="CT" GroupName="dashboard-side"
                                             IsChecked="{Binding Report.IsCt}" AutomationProperties.Name="CT side" />
                                <RadioButton Classes="seg t" Content="T" GroupName="dashboard-side"
                                             IsChecked="{Binding Report.IsT}" AutomationProperties.Name="T side" />
                            </StackPanel>
                            <TextBlock Classes="mid" Text="Buy" VerticalAlignment="Center" />
                            <ComboBox FontSize="12" ItemsSource="{x:Static vm:ScoutingReportTabViewModel.BuyOptions}"
                                      SelectedItem="{Binding Report.Buy}" AutomationProperties.Name="Buy filter" />
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 1 0 0" Padding="14 6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="mid" Text="{Binding Report.ScopeLine}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="ghost" FontSize="11" Padding="8 3" Margin="12 0 0 0"
                                    VerticalAlignment="Center" Content="Process this team first"
                                    IsVisible="{Binding Report.CanProcessTeamFirst}"
                                    Command="{Binding Report.ProcessTeamFirstCommand}"
                                    ToolTip.Tip="Queue every demo of this team ahead of the rest of the library" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Report.Notices}" IsVisible="{Binding Report.HasNotices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Classes="notice" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 1 0 0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Panel Width="14" Height="14" VerticalAlignment="Top" Margin="0 1 0 0">
                                            <Ellipse Stroke="{DynamicResource AccentCaution}" StrokeThickness="1.6" />
                                            <Path Data="M7,3.5 L7,8 M7,10 L7,10.6" Stroke="{DynamicResource AccentCaution}"
                                                  StrokeThickness="1.6" />
                                        </Panel>
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextValue}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="mid" Text="{Binding Report.ReviewLine}" Margin="14 6"
                               IsVisible="{Binding Report.ReviewLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- The one-pager: what Export writes. -->
            <Border Classes="panel" Padding="14 12" IsVisible="{Binding Report.HasMaps}">
                <StackPanel Spacing="4">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Classes="h" FontSize="15" Text="{Binding Report.Editor.OnePagerHeading}" Margin="0 0 12 0" />
                        <TextBlock Classes="mid" Text="every card below leads with a finding; star it to send it"
                                   VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Classes="mid" TextWrapping="Wrap" IsVisible="{Binding !Report.Editor.HasStarred}"
                               Text="Nothing starred yet. Export stays off until something is." />
                    <ItemsControl ItemsSource="{Binding Report.Editor.Starred}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScoutingReportFindingViewModel">
                                <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1" Padding="0 4">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Button Grid.Column="0" Classes="ghost" Padding="3" VerticalAlignment="Top" Margin="0 0 8 0"
                                                Command="{Binding $parent[UserControl].((dash:ScoutingDashboardTabViewModel)DataContext).Report.UnstarCommand, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding}" ToolTip.Tip="Take it off the one-pager">
                                            <AutomationProperties.Name>
                                                <MultiBinding StringFormat="Unstar &quot;{0}&quot; · {1}">
                                                    <Binding Path="Text" />
                                                    <Binding Path="Where" />
                                                </MultiBinding>
                                            </AutomationProperties.Name>
                                            <Path Classes="star on" Data="{StaticResource StarGeometry}" />
                                        </Button>
                                        <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center">
                                            <Run Text="{Binding Where}" Foreground="{DynamicResource TextBright}" />
                                            <Run Text=" · " Foreground="{DynamicResource TextBright}" />
                                            <Run Text="{Binding DisplayText}" Foreground="{DynamicResource TextValue}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextBright}" Margin="0 4 0 0"
                               Text="Suggested findings start starred. Lines export in map, then CT, then T order." />
                </StackPanel>
            </Border>

            <!-- The map's record and its map-wide facts. -->
            <Grid ColumnDefinitions="2*,14,3*" IsVisible="{Binding Report.HasMaps}">
                <Border Grid.Column="0" Classes="card" DataContext="{Binding Report.SelectedMap}"
                        x:DataType="vm:MapPoolRowViewModel">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"
                                   Text="{Binding $parent[UserControl].((dash:ScoutingDashboardTabViewModel)DataContext).RecordTitle, FallbackValue=''}" />
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextValue}"
                                   Text="{Binding Played, StringFormat='Matches played {0}'}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="val" Text="{Binding WinLossLabel, StringFormat='Won–lost {0}'}" />
                            <TextBlock Grid.Column="1" Classes="val" Text="{Binding WinRateLabel}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Pb2dTeamCt}" Text="CT rounds" />
                            <TextBlock Grid.Column="1" Classes="val" Text="{Binding CtLabel}" ToolTip.Tip="{Binding CtToolTip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Pb2dTeamT}" Text="T rounds" />
                            <TextBlock Grid.Column="1" Classes="val" Text="{Binding TLabel}" ToolTip.Tip="{Binding TToolTip}" />
                        </Grid>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextBright}" TextWrapping="Wrap"
                                   Text="Round win %, the team's own rounds on each side." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"
                                   Text="{Binding MapWideHeading}" />
                        <Grid ColumnDefinitions="*,Auto,24,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4"
                              DataContext="{Binding Report.SelectedMap}" x:DataType="vm:MapPoolRowViewModel">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="mid" Text="Pistols won" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="val" Text="{Binding PistolsLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Classes="mid" Text="Plant, median after freeze end" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Classes="val" Text="{Binding PlantLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="mid" Text="AWP bought" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="val" Text="{Binding AwpLabel}" ToolTip.Tip="{Binding AwpToolTip}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Classes="mid" Text="Last played" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Classes="val" Text="{Binding LastPlayedLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="mid" Text="Veto history (manual)" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="val"
                                       Text="{Binding $parent[UserControl].((dash:ScoutingDashboardTabViewModel)DataContext).VetoLine, FallbackValue=''}" />
                        </Grid>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextBright}" TextWrapping="Wrap"
                                   Text="The pistol, after-pistol and anti-eco rows are in the Economy card below." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- The side in view. -->
            <TextBlock Classes="section" Text="{Binding SideHeading}" Margin="0 6 0 0" IsVisible="{Binding Report.HasMaps}" />
            <ItemsControl Classes="cards" ItemsSource="{Binding SideCards}" ItemTemplate="{StaticResource Card}"
                          ItemsPanel="{StaticResource CardGrid}" IsVisible="{Binding Report.HasMaps}" />
            <ContentControl Content="{Binding AwpCard}" ContentTemplate="{StaticResource WideMapCard}"
                            IsVisible="{Binding Report.HasMaps}" />

            <!-- Map-wide. -->
            <TextBlock Classes="section" Text="{Binding MapWideHeading}" Margin="0 6 0 0" IsVisible="{Binding Report.HasMaps}" />
            <ItemsControl Classes="cards" ItemsSource="{Binding MapWideCards}" ItemTemplate="{StaticResource Card}"
                          ItemsPanel="{StaticResource MapWideGrid}" IsVisible="{Binding Report.HasMaps}" />

            <!-- Below: the Period Diff, the veto history and the long form, collapsed. -->
            <Border Classes="panel" Padding="8 4" IsVisible="{Binding Report.HasSelection}">
                <StackPanel>
                    <Button Classes="ghost" Padding="6 6" HorizontalAlignment="Left" Command="{Binding Report.TogglePeriodCommand}"
                            AutomationProperties.Name="Roster and form">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="chevron" Classes.open="{Binding Report.IsPeriodOpen}" />
                            <TextBlock Classes="h" Text="Roster and form · Period Diff" />
                        </StackPanel>
                    </Button>
                    <StackPanel Spacing="8" Margin="26 2 6 12" IsVisible="{Binding Report.IsPeriodOpen}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="mid" Text="demos per period" VerticalAlignment="Center" />
                            <ComboBox FontSize="12" ItemsSource="{x:Static vm:ScoutingReportTabViewModel.WindowSizeOptions}"
                                      SelectedItem="{Binding Report.WindowSize}" />
                        </StackPanel>
                        <TextBlock Classes="val" Text="{Binding Report.PeriodDiffNote}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,10,*" IsVisible="{Binding Report.HasPeriodDiff}">
                            <Border Grid.Column="0" Padding="10" BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1" CornerRadius="6">
                                <StackPanel Spacing="4" DataContext="{Binding Report.PeriodDiffRecent}" x:DataType="vm:PeriodDiffRowViewModel">
                                    <TextBlock Text="last" FontSize="11" Foreground="{DynamicResource TextCardHeader}" />
                                    <TextBlock Classes="val" Text="{Binding CountLabel}" />
                                    <TextBlock Classes="val" Text="{Binding RecordLabel}" />
                                    <TextBlock Classes="val" Text="{Binding WinRateLabel}" />
                                    <TextBlock Classes="mid" Text="{Binding SideLabel}" />
                                    <TextBlock Classes="mid" Text="{Binding RosterLabel}" />
                                    <TextBlock Classes="mid" Text="{Binding StandInLabel}" IsVisible="{Binding HasStandIn}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="10" BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1" CornerRadius="6">
                                <StackPanel Spacing="4" DataContext="{Binding Report.PeriodDiffPrevious}" x:DataType="vm:PeriodDiffRowViewModel">
                                    <TextBlock Text="previous" FontSize="11" Foreground="{DynamicResource TextCardHeader}" />
                                    <TextBlock Classes="val" Text="{Binding CountLabel}" />
                                    <TextBlock Classes="val" Text="{Binding RecordLabel}" />
                                    <TextBlock Classes="val" Text="{Binding WinRateLabel}" />
                                    <TextBlock Classes="mid" Text="{Binding SideLabel}" />
                                    <TextBlock Classes="mid" Text="{Binding RosterLabel}" />
                                    <TextBlock Classes="mid" Text="{Binding StandInLabel}" IsVisible="{Binding HasStandIn}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Button Classes="ghost" Padding="6 6" HorizontalAlignment="Left" Command="{Binding Report.ToggleVetoCommand}"
                            AutomationProperties.Name="Veto history">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="chevron" Classes.open="{Binding Report.IsVetoOpen}" />
                            <TextBlock Classes="h" Text="Veto history (manual entry)" />
                        </StackPanel>
                    </Button>
                    <StackPanel Spacing="8" Margin="26 2 6 12" IsVisible="{Binding Report.IsVetoOpen}">
                        <TextBlock Classes="mid" Text="session only: this browser tab forgets veto entries when it reloads"
                                   IsVisible="{Binding Report.VetoesAreSessionOnly}" />
                        <TextBlock Classes="mid" Text="no veto steps recorded for this team yet"
                                   IsVisible="{Binding !Report.HasVetoes}" />
                        <ItemsControl ItemsSource="{Binding Report.Vetoes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VetoRowViewModel">
                                    <Grid ColumnDefinitions="30,120,60,60,*,Auto" ColumnSpacing="8" Margin="0 0 0 4">
                                        <TextBlock Grid.Column="0" Classes="mid" Text="{Binding Order}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="val" Text="{Binding Map}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="val" Text="{Binding ActionLabel}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Classes="mid" Text="{Binding ByLabel}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Classes="mid" Text="{Binding Note}" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="5" Content="Remove" Classes="ghost" FontSize="11" Padding="8 3"
                                                Command="{Binding $parent[UserControl].((dash:ScoutingDashboardTabViewModel)DataContext).Report.RemoveVetoCommand, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="120,90,Auto,*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding Report.NewVetoMap}" FontSize="12" PlaceholderText="map" />
                            <ComboBox Grid.Column="1" FontSize="12"
                                      ItemsSource="{x:Static vm:ScoutingReportTabViewModel.VetoActionOptions}"
                                      SelectedItem="{Binding Report.NewVetoAction}" />
                            <CheckBox Grid.Column="2" Content="by them" IsChecked="{Binding Report.NewVetoByOpponent}"
                                      FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Content="Add" Classes="ghost" FontSize="12" Padding="10 5"
                                    Command="{Binding Report.AddVetoCommand}" />
                        </Grid>
                    </StackPanel>

                    <Button Classes="ghost" Padding="6 6" HorizontalAlignment="Left" Command="{Binding Report.ToggleNotesCommand}"
                            AutomationProperties.Name="Long form and notes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="chevron" Classes.open="{Binding Report.IsNotesOpen}" />
                            <TextBlock Classes="h" Text="Long form and notes" />
                            <TextBlock Classes="mid" Text="{Binding Report.Editor.CountsLine}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Panel IsVisible="{Binding Report.IsNotesOpen}">
                        <StackPanel Spacing="8" Margin="26 2 6 12" DataContext="{Binding Report.Editor}"
                                    x:DataType="vm:ScoutingReportEditorViewModel">
                            <TextBlock Classes="mid" TextWrapping="Wrap"
                                       Text="Every line not dismissed, across all maps and sides. Rewrite, reset or dismiss a line in the Layers tab; stars and the summary are shared." />
                            <TextBox Text="{Binding Summary, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontSize="12"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                                     PlaceholderText="summary: your own read, printed at the top of both forms" />
                            <TextBlock Classes="mid" Text="{Binding EmptyLine}" TextWrapping="Wrap"
                                       IsVisible="{Binding !HasFindings}" />
                            <ItemsControl ItemsSource="{Binding Findings}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScoutingReportFindingViewModel">
                                        <StackPanel Spacing="2" Margin="0 0 0 2">
                                            <TextBlock Text="{Binding SectionLabel}" FontSize="11" Margin="0 6 0 2"
                                                       Foreground="{DynamicResource TextCardHeader}" IsVisible="{Binding ShowsSectionHeader}" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                <Button Grid.Column="0" Classes="ghost" Padding="3" VerticalAlignment="Top"
                                                        ToolTip.Tip="{Binding StarToolTip}"
                                                        Command="{Binding $parent[UserControl].((dash:ScoutingDashboardTabViewModel)DataContext).Report.Editor.ToggleStarCommand, FallbackValue={x:Null}}"
                                                        CommandParameter="{Binding}">
                                                    <AutomationProperties.Name>
                                                        <MultiBinding StringFormat="{}{0} · &quot;{1}&quot; · {2}">
                                                            <Binding Path="StarToolTip" />
                                                            <Binding Path="Text" />
                                                            <Binding Path="Where" />
                                                        </MultiBinding>
                                                    </AutomationProperties.Name>
                                                    <Path Classes="star" Classes.on="{Binding IsStarred}" Data="{StaticResource StarGeometry}" />
                                                </Button>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="11" TextWrapping="Wrap"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextValue}" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Panel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
