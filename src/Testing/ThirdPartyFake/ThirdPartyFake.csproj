<Project Sdk="Microsoft.NET.Sdk">

    <!--
      A stand-in for an out-of-tree extension, built against the SDK and its UI kit alone: its own root namespace,
      no app assembly, no InternalsVisibleTo. The app tests and UiCapture use it to prove an extension's views
      resolve and render from its own namespace with the host's look.
    -->
    <PropertyGroup>
        <RootNamespace>ThirdPartyFake</RootNamespace>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ExtensionManifestVersion>1.0.0</ExtensionManifestVersion>
    </PropertyGroup>

    <Import Project="..\..\Sdk\DemoViewer.NET.Extensions.Sdk\build\DemoViewer.NET.Extensions.Sdk.targets"/>

    <!-- The stamped manifest stays beside this DLL only. The shipped packs copy theirs as <id>.extension.json,
         so nothing collides any more, but a bare extension.json flowing into App.Tests' output would read as a
         manifest of something the test host ships, which this fake is not. -->
    <Target Name="KeepManifestOutOfReferencingProjects" AfterTargets="StampExtensionManifest">
        <ItemGroup>
            <None Remove="$(StampedExtensionManifest)"/>
        </ItemGroup>
    </Target>

    <Target Name="CopyManifestBesideTheFake" AfterTargets="Build">
        <Copy SourceFiles="$(StampedExtensionManifest)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"/>
    </Target>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Sdk\DemoViewer.NET.Extensions.Sdk\DemoViewer.NET.Extensions.Sdk.csproj"/>
        <ProjectReference Include="..\..\Sdk\DemoViewer.NET.Extensions.Sdk.Ui\DemoViewer.NET.Extensions.Sdk.Ui.csproj"/>
    </ItemGroup>

</Project>
